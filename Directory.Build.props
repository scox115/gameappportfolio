<Project>
  <PropertyGroup>
    <!-- Local builds are 1.0.0. The deploy workflow passes Version=1.0.<deploy run number> and the
         commit, so the version the game shows changes with every deploy. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Scott Cox</Authors>
    <Company>Scott Cox</Company>
    <Product>Kings of the Card Arena</Product>
    <Copyright>Copyright © 2026 Scott Cox</Copyright>
  </PropertyGroup>
</Project>
