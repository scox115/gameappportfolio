@using System.Net.Http.Json
@using Game.Client.Services
@inject HttpClient Http

@* Lets a hero pick one of the playable classes. The class list and its rules come from the server. *@
@if (classes is { Count: > 0 })
{
    <div class="class-picker">
        @if (!string.IsNullOrEmpty(Heading))
        {
            <label class="class-picker-heading">@Heading</label>
        }
        <div class="class-options">
            @foreach (var option in classes.Where(c => c.id != Exclude))
            {
                var selected = option.id == Selected;
                var (ability, effect) = SplitAbility(option.description);
                <button type="button" @onclick="() => Pick(option.id)"
                        aria-pressed="@(selected ? "true" : "false")"
                        class="class-option @(selected ? "is-selected" : "")">
                    <span class="class-option-icon">@HeroClassIcons.For(option.id)</span>
                    <span>
                        <span class="class-option-name">@option.name@(string.IsNullOrEmpty(ability) ? "" : $" · {ability}")</span>
                        <span class="class-option-effect">@effect</span>
                    </span>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public string? Heading { get; set; }

    /// <summary>A class to leave out, such as the one the hero already has.</summary>
    [Parameter] public string? Exclude { get; set; }

    private List<HeroClassDto>? classes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            classes = await Http.GetFromJsonAsync<List<HeroClassDto>>("/api/v1/classes");
        }
        catch (Exception)
        {
            // Without the list, new heroes start as Sorcerers.
        }
    }

    private Task Pick(string heroClass) => SelectedChanged.InvokeAsync(heroClass);

    // Descriptions read "Ability Name: what it does".
    private static (string ability, string effect) SplitAbility(string description)
    {
        var colon = description.IndexOf(':');
        return colon > 0
            ? (description[..colon], description[(colon + 1)..].Trim())
            : ("", description);
    }

    public class HeroClassDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("class")]
        public string id { get; set; } = "";
        public string name { get; set; } = "";
        public string description { get; set; } = "";
        public int changePrice { get; set; }
    }
}
