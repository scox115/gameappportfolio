@using System.Net.Http.Json
@inject HttpClient Http

@* Today's bounties and the player's win streak. The server tracks progress and pays rewards
   automatically after each battle; this panel only shows where the player stands. *@
<div class="arena-panel bounty-panel">
    <div class="bounty-head">
        <h4 class="bounty-title">📜 Daily Bounties</h4>
        @if (board is not null)
        {
            <span class="bounty-reset">New bounties in @UntilReset()</span>
        }
    </div>

    @if (board is null)
    {
        <p class="bounty-loading">@(loadFailed ? "The bounty board is unavailable right now." : "Reading the bounty board...")</p>
    }
    else
    {
        <div class="bounty-grid">
            @foreach (var bounty in board.bounties)
            {
                <div class="bounty-card @(bounty.completed ? "is-completed" : "")">
                    <div class="bounty-name">@(bounty.completed ? "✅ " : "")@bounty.name</div>
                    <div class="bounty-bar">
                        <div class="bounty-bar-fill @(bounty.completed ? "is-completed" : "")" style="--progress: @(bounty.progress * 100 / Math.Max(1, bounty.goal))%"></div>
                    </div>
                    <div class="bounty-numbers">
                        <span class="bounty-progress">@bounty.progress / @bounty.goal</span>
                        <span class="bounty-reward">@(bounty.completed ? "Paid" : "Reward") 🪙 @bounty.reward</span>
                    </div>
                </div>
            }
        </div>
        <p class="bounty-note">
            🔥 Win streak: <b>@board.winStreak</b>.
            @(board.streakBonus > 0
                ? $"Your next win pays +{board.streakBonus} bonus gold."
                : "Win battles in a row for up to +50 bonus gold per win.")
        </p>
        <p class="bounty-note bounty-note-next">
            ⚔️ Boss rewards: <b>@board.fullRewardBossWinsLeft of @board.fullRewardBossWinsPerDay</b> full-reward wins left today.
            @(board.fullRewardBossWinsLeft == 0 ? "Boss wins pay 25 gold until tomorrow." : "")
        </p>
    }
</div>

@code {
    private BountiesDto? board;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            board = await Http.GetFromJsonAsync<BountiesDto>("/api/v1/bounties");
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private string UntilReset()
    {
        var left = board!.resetsAt.ToUniversalTime() - DateTime.UtcNow;
        if (left <= TimeSpan.Zero) return "a moment";
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours}h {left.Minutes}m" : $"{Math.Max(1, left.Minutes)}m";
    }

    private class BountiesDto
    {
        public DateTime resetsAt { get; set; }
        public int winStreak { get; set; }
        public int streakBonus { get; set; }
        public int fullRewardBossWinsLeft { get; set; }
        public int fullRewardBossWinsPerDay { get; set; }
        public List<BountyDto> bounties { get; set; } = new();
    }

    private class BountyDto
    {
        public string name { get; set; } = "";
        public int goal { get; set; }
        public int progress { get; set; }
        public int reward { get; set; }
        public bool completed { get; set; }
    }
}
