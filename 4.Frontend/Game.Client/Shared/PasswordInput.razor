@* A password box with a button that shows what was typed, and a warning while Caps Lock is on.
   Attributes such as id, autocomplete, placeholder, class and style go on the input itself. *@
<div class="password-field">
    <input @attributes="AdditionalAttributes" type="@(visible ? "text" : "password")" value="@Value"
           @oninput="OnInputAsync" @onkeydown="OnKeyDown" @onfocus="() => focused = true" @onblur="() => focused = false"
           autocapitalize="off" spellcheck="false" />
    <button type="button" class="password-toggle" @onclick="() => visible = !visible"
            aria-pressed="@(visible ? "true" : "false")" aria-label="@(visible ? "Hide password" : "Show password")">
        @(visible ? "🙈 Hide" : "👁️ Show")
    </button>
</div>
@* Always in the page, so screen readers announce the warning when it appears. *@
<p class="caps-warning" aria-live="polite">@(capsLockOn && focused ? "⇪ Caps Lock is on" : "")</p>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool visible;
    private bool focused;
    private bool capsLockOn;
    private bool capsLockKnown;

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    // Blazor doesn't pass the browser's Caps Lock state, so it's read from the letters typed: a capital
    // without Shift, or a small letter with it, means Caps Lock is on.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "CapsLock")
        {
            if (capsLockKnown) capsLockOn = !capsLockOn;
            return;
        }
        if (e.Key.Length != 1 || !(char.IsUpper(e.Key[0]) || char.IsLower(e.Key[0]))) return;
        capsLockOn = char.IsUpper(e.Key[0]) != e.ShiftKey;
        capsLockKnown = true;
    }
}
