@using System.Net
@inject HttpClient Http

@* "Recovery email" in the account dialog: add, change or remove the address password reset links go to. *@
<h5 class="recovery-email-title">Recovery email</h5>
@if (current is null)
{
    <p class="recovery-email-loading">Loading…</p>
}
else
{
    <p class="recovery-email-note">
        @if (current.email is { } email)
        {
            <span>Reset links go to <b class="recovery-email-address">@email</b>.</span>
        }
        else
        {
            <span>Add an email address so you can reset your password if you forget it. It's used for nothing else.</span>
        }
        @if (current.pending is { } pending)
        {
            <span> We sent a confirmation link to <b class="recovery-email-address">@pending</b>; click it to finish.</span>
        }
    </p>
    <label for="recovery-email" class="recovery-email-label">@(current.email is null ? "Email address" : "New email address")</label>
    <input id="recovery-email" type="email" autocomplete="email" @bind="address" @bind:event="oninput"
           class="recovery-email-input" />
    <label for="recovery-password" class="recovery-email-label recovery-email-password-label">Your password</label>
    <PasswordInput id="recovery-password" autocomplete="current-password" @bind-Value="password" class="dialog-input" />
    <div class="recovery-email-actions">
        <button @onclick="SaveAsync" disabled="@(busy || string.IsNullOrWhiteSpace(address) || string.IsNullOrEmpty(password))"
                class="recovery-email-save @(busy || string.IsNullOrWhiteSpace(address) || string.IsNullOrEmpty(password) ? "is-disabled" : "")">
            Send confirmation link
        </button>
        @if (current.email is not null || current.pending is not null)
        {
            <button @onclick="RemoveAsync" disabled="@(busy || string.IsNullOrEmpty(password))"
                    class="recovery-email-remove @(busy || string.IsNullOrEmpty(password) ? "is-disabled" : "")">
                Remove
            </button>
        }
    </div>
}
@if (!string.IsNullOrEmpty(message))
{
    <p role="@(failed ? "alert" : "status")" class="recovery-email-message @(failed ? "is-failed" : "")">@message</p>
}

@code {
    private Current? current;
    private string address = string.Empty;
    private string password = string.Empty;
    private bool busy;
    private bool failed;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            current = await Http.GetFromJsonAsync<Current>("/api/v1/players/me/recovery-email");
        }
        catch (HttpRequestException)
        {
            (failed, message) = (true, "Your recovery email couldn't be loaded.");
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/v1/players/me/recovery-email", new { Email = address.Trim(), Password = password });
            if (response.IsSuccessStatusCode)
            {
                current = await response.Content.ReadFromJsonAsync<Current>();
                (failed, message) = (false, $"Check {address.Trim()} for a confirmation link.");
                address = password = string.Empty;
            }
            else
            {
                (failed, message) = (true, Explain(response.StatusCode, await ProblemText.ReadAsync(response)));
            }
        }
        catch (HttpRequestException)
        {
            (failed, message) = (true, "The game server couldn't be reached. Please try again.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RemoveAsync()
    {
        busy = true;
        try
        {
            var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "/api/v1/players/me/recovery-email")
            {
                Content = JsonContent.Create(new { Password = password })
            });
            if (response.IsSuccessStatusCode)
            {
                current = new Current(null, null);
                (failed, message) = (false, "Your recovery email was removed.");
                password = string.Empty;
            }
            else
            {
                (failed, message) = (true, Explain(response.StatusCode, await ProblemText.ReadAsync(response)));
            }
        }
        catch (HttpRequestException)
        {
            (failed, message) = (true, "The game server couldn't be reached. Please try again.");
        }
        finally
        {
            busy = false;
        }
    }

    private static string Explain(HttpStatusCode status, string? problem) => status switch
    {
        HttpStatusCode.Locked => "Too many wrong passwords. Please try again later.",
        HttpStatusCode.TooManyRequests => problem ?? "Too many attempts. Please wait a few minutes and try again.",
        _ => problem ?? "That didn't work. Please try again.",
    };

    private sealed record Current(string? email, string? pending);
}
