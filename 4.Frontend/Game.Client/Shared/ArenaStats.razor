@using System.Net.Http.Json
@inject HttpClient Http

@* Arena-wide totals for today and the past week, counted in the background from RabbitMQ match events. *@
@if (days is { Count: > 0 })
{
    var today = days[0];
    var week = days.Take(7).ToList();
    var bossFights = today.bossFights + today.heroicFights;
    var bossWins = today.bossWins + today.heroicWins;
    <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; font-size: 0.85rem;">
        <span style="@Chip">📊 Today: <b>@bossFights</b> boss fight@(bossFights == 1 ? "" : "s")@(bossFights > 0 ? $" ({bossWins * 100 / bossFights}% won)" : "")</span>
        @if (today.heroicFights > 0)
        {
            <span style="@Chip">👑 Heroic: <b>@today.heroicWins</b> of @today.heroicFights won</span>
        }
        <span style="@Chip">🆚 Duels: <b>@today.duels</b></span>
        <span style="@Chip">🪙 Paid today: <b>@today.goldPaid.ToString("N0")</b></span>
        <span style="@Chip">📅 This week: <b>@week.Sum(d => d.bossFights + d.heroicFights + d.duels)</b> matches</span>
    </div>
}

@code {
    private const string Chip = "background: #0f172a; border: 1px solid #334155; border-radius: 20px; padding: 6px 12px; color: #cbd5e1;";
    private List<DayDto>? days;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            days = await Http.GetFromJsonAsync<List<DayDto>>("/api/v1/arena/stats?days=7");
        }
        catch (Exception)
        {
            // The leaderboard still works without the stats strip.
        }
    }

    private class DayDto
    {
        public int bossFights { get; set; }
        public int bossWins { get; set; }
        public int heroicFights { get; set; }
        public int heroicWins { get; set; }
        public int duels { get; set; }
        public int goldPaid { get; set; }
    }
}
