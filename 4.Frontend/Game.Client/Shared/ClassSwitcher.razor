@using System.Net.Http.Json
@using Game.Client.Services
@inject HttpClient Http
@inject GameState State
@implements IDisposable

@* Shows the hero's class on the dashboard and lets them switch to another for gold. *@
<p class="class-line">
    Class: <b class="class-name">@HeroClassIcons.For(State.HeroClass) @State.HeroClass</b>
    <button @onclick="Toggle" class="class-change-toggle">
        @(open ? "Cancel" : "Change")
    </button>
</p>

@if (open)
{
    <div class="class-switch-panel">
        <ClassPicker @bind-Selected="newClass" Exclude="@State.HeroClass" Heading="@($"Switch class for {Price} gold:")" />
        <button @onclick="Confirm" disabled="@(newClass is null || saving)"
                class="class-confirm @(newClass is null ? "is-waiting" : "")">
            @(newClass is null ? "Pick a class" : $"Become a {newClass} for {Price} gold")
        </button>
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="class-error">@message</p>
        }
    </div>
}

@code {
    // Matches HeroClasses.ChangePrice on the server, which is what actually charges.
    private const int Price = 300;

    private bool open;

    // The class can change after this first renders (sign-in, or a switch), so follow the shared state.
    protected override void OnInitialized() => State.OnStateChanged += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnStateChanged -= Refresh;

    private bool saving;
    private string? newClass;
    private string? message;

    private void Toggle()
    {
        open = !open;
        newClass = null;
        message = null;
    }

    private async Task Confirm()
    {
        if (newClass is null) return;
        saving = true;
        message = null;
        try
        {
            var res = await Http.PutAsJsonAsync("/api/v1/players/me/class", new { Class = newClass });
            if (res.IsSuccessStatusCode && await res.Content.ReadFromJsonAsync<ProfileDto>() is { } me)
            {
                State.UpdateGold(me.gold);
                State.UpdateClass(me.@class);
                open = false;
                newClass = null;
            }
            else
            {
                var problem = await res.Content.ReadFromJsonAsync<ProblemDto>();
                message = problem?.detail ?? "Couldn't change class. Please try again.";
            }
        }
        catch (Exception)
        {
            message = "Couldn't reach the server. Please try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private record ProfileDto(int gold, string @class);
    private record ProblemDto(string? detail);
}
