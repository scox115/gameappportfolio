@using System.Net.Http.Json
@using Game.Client.Services
@inject HttpClient Http

@* The hero's latest matches. The server builds this list in the background from RabbitMQ match
   events, so a battle that just ended can take a moment to appear. *@
<div class="arena-panel" style="max-width: 1100px; margin: 25px auto 0; background: #1e293b; padding: 20px 30px; border-radius: 16px; border: 1px solid #334155;">
    <h4 style="margin: 0 0 12px; color: #f1f5f9; font-size: 1.2rem;">📖 Recent Matches</h4>

    @if (matches is null)
    {
        <p style="color: #94a3b8; margin: 0;">@(loadFailed ? "Match history is unavailable right now." : "Loading your matches...")</p>
    }
    else if (matches.Count == 0)
    {
        <p style="color: #94a3b8; margin: 0;">No matches yet. Your battles show up here a moment after they end.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 6px;">
            @foreach (var m in matches)
            {
                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; background: #0f172a; border-left: 4px solid @(m.won ? "#22c55e" : "#ef4444"); border-radius: 8px; padding: 8px 14px; font-size: 0.9rem;">
                    <span style="font-weight: bold; color: @(m.won ? "#4ade80" : "#f87171"); min-width: 40px;">@(m.won ? "WIN" : "LOSS")</span>
                    <span style="color: #f1f5f9; flex: 1; min-width: 180px;">
                        @(m.kind == "Duel" ? "🆚" : m.difficulty == "Heroic" ? "👑" : "😈") @m.opponentName @(m.opponentClass is null ? "" : HeroClassIcons.For(m.opponentClass))
                        <span style="color: #94a3b8;"> · you as @HeroClassIcons.For(m.heroClass) @m.heroClass · @Describe(m)</span>
                    </span>
                    @if (m.ratingChange is { } rating && rating != 0)
                    {
                        <span style="color: @(rating > 0 ? "#22d3ee" : "#f87171"); font-weight: bold;">🏅 @(rating > 0 ? "+" : "")@rating</span>
                    }
                    <span style="color: #fbbf24; font-weight: bold;">🪙 @Signed(m.goldEarned + m.wagerResult)</span>
                    <span style="color: #94a3b8; min-width: 70px; text-align: right;" title="@DateTime.SpecifyKind(m.playedAt, DateTimeKind.Utc).ToLocalTime().ToString("g")">@Ago(m.playedAt)</span>
                    @if (m.replayId is { } replay)
                    {
                        <a href="replay/@replay" class="match-replay" aria-label="Replay the duel against @m.opponentName">▶ Replay</a>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MatchDto>? matches;
    private bool loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            matches = await Http.GetFromJsonAsync<List<MatchDto>>("/api/v1/players/me/matches?limit=5");
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private static string Describe(MatchDto m) => m.kind == "Duel"
        ? m.endReason switch
        {
            "Timeout" => $"{(m.won ? "opponent" : "you")} ran out of time",
            "Forfeit" => $"{(m.won ? "opponent" : "you")} forfeited",
            _ => $"knockout in {m.turns} moves"
        }
        : $"{m.turns} turns";

    private static string Signed(int value) => value > 0 ? $"+{value}" : value.ToString();

    private static string Ago(DateTime playedAt)
    {
        var ago = DateTime.UtcNow - DateTime.SpecifyKind(playedAt, DateTimeKind.Utc);
        if (ago < TimeSpan.FromMinutes(1)) return "just now";
        if (ago < TimeSpan.FromHours(1)) return $"{(int)ago.TotalMinutes}m ago";
        if (ago < TimeSpan.FromDays(1)) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private class MatchDto
    {
        public string kind { get; set; } = "";
        public Guid? replayId { get; set; }
        public bool won { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("class")]
        public string heroClass { get; set; } = "";
        public string opponentName { get; set; } = "";
        public string? opponentClass { get; set; }
        public string? difficulty { get; set; }
        public string? endReason { get; set; }
        public int turns { get; set; }
        public int goldEarned { get; set; }
        public int? ratingChange { get; set; }
        public int wagerResult { get; set; }
        public DateTime playedAt { get; set; }
    }
}
