@using System.Net
@inject HttpClient Http
@inject GameState State
@inject IJSRuntime JS

@* "Your account": download everything the game stores about the hero, or delete the hero for good. *@
<button @onclick="Open" class="account-open">
    ⚙️ Your account and data
</button>

@if (open)
{
    <div role="dialog" aria-modal="true" aria-labelledby="account-title" @onclick="Close" @onkeydown="KeyDown"
         class="account-backdrop">
        <div @onclick:stopPropagation="true" class="account-dialog">
            <div class="account-head">
                <h4 id="account-title" class="account-title">⚙️ Your account</h4>
                <button aria-label="Close" @onclick="Close" @ref="closeButton"
                        class="account-close">✕</button>
            </div>

            <h5 class="account-section">Your data</h5>
            <p class="account-note">
                Download a copy of everything the game stores about @State.Username: your hero, purchases, match history and sign-ins.
            </p>
            <button @onclick="DownloadAsync" disabled="@busy" class="account-download">
                @(downloading ? "Preparing your file..." : "⬇️ Download my data")
            </button>

            <FeatureGate Feature="@FeatureFlags.AccountRecovery">
                <RecoveryEmail />
            </FeatureGate>

            <TwoFactorSettings />

            <h5 class="account-danger-section">Delete your hero</h5>
            <p class="account-note">
                This deletes @State.Username, your gold, upgrades and match history for good, and frees the name for someone else.
                It can't be undone. Opponents keep their record of your duels, without your name.
            </p>
            <label for="delete-password" class="account-label">Your password, to confirm</label>
            <PasswordInput id="delete-password" autocomplete="current-password" @bind-Value="password"
                   class="account-password" />
            <button @onclick="DeleteAsync" disabled="@(busy || string.IsNullOrEmpty(password))"
                    class="account-delete @(busy || string.IsNullOrEmpty(password) ? "is-disabled" : "")">
                @(deleting ? "Deleting..." : "Delete my hero forever")
            </button>

            @if (!string.IsNullOrEmpty(message))
            {
                <p role="alert" class="account-error">@message</p>
            }
        </div>
    </div>
}

@code {
    /// <summary>Shown on the sign-in screen once the hero is gone.</summary>
    public const string DeletedMessage = "Your hero was deleted. Thanks for playing!";

    private bool open;
    private bool focusOnRender;
    private bool downloading;
    private bool deleting;
    private bool busy => downloading || deleting;
    private string password = string.Empty;
    private string message = string.Empty;
    private ElementReference closeButton;

    private void Open()
    {
        password = string.Empty;
        message = string.Empty;
        open = true;
        focusOnRender = true; // keyboard and screen-reader users land inside the dialog
    }

    private void Close()
    {
        if (!busy) open = false;
    }

    private void KeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusOnRender)
        {
            focusOnRender = false;
            await closeButton.FocusAsync();
        }
    }

    private async Task DownloadAsync()
    {
        downloading = true;
        message = string.Empty;
        try
        {
            using var response = await Http.GetAsync("/api/v1/players/me/export");
            if (!response.IsSuccessStatusCode)
            {
                message = "Your data couldn't be downloaded. Please try again.";
                return;
            }

            var disposition = response.Content.Headers.ContentDisposition;
            var fileName = disposition?.FileNameStar ?? disposition?.FileName?.Trim('"') ?? "card-arena-data.json";
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("gameFiles.save", fileName, "application/json", bytes);
        }
        catch (HttpRequestException)
        {
            message = "The game server couldn't be reached. Please try again.";
        }
        finally
        {
            downloading = false;
        }
    }

    private async Task DeleteAsync()
    {
        deleting = true;
        message = string.Empty;
        try
        {
            using var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "/api/v1/players/me")
            {
                Content = JsonContent.Create(new { Password = password })
            });

            if (response.IsSuccessStatusCode)
            {
                deleting = false;
                open = false;
                // The account and its tokens are already gone on the server; just forget them here.
                State.SignOut(DeletedMessage);
                return;
            }

            message = response.StatusCode switch
            {
                HttpStatusCode.BadRequest => "That password isn't right.",
                HttpStatusCode.Conflict => "Finish or forfeit your duel first, then try again.",
                HttpStatusCode.Locked => "Too many wrong passwords. Please try again later.",
                HttpStatusCode.TooManyRequests => "Too many attempts. Please wait a minute and try again.",
                _ => "Your hero couldn't be deleted. Please try again.",
            };
        }
        catch (HttpRequestException)
        {
            message = "The game server couldn't be reached. Please try again.";
        }
        finally
        {
            deleting = false;
        }
    }
}
