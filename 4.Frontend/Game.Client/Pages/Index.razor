@page "/"

<div class="game-client-shell">

    @* The header bar: the game's name, and the hero's status once signed in *@
    <GameHeader OnShowLeaderboards="ShowLeaderboards" />

    @* The screen the player is on *@
    @switch (State.CurrentScreen)
    {
        case GameScreen.LoginMenu:
            <SignInPanel />
            break;

        case GameScreen.CharacterDashboard:
            <TownDashboard OnBattleStarted="StartBossBattle" />
            break;

        case GameScreen.PvpArena:
            <PvpArena />
            break;

        case GameScreen.Shop:
            <Shop />
            break;

        case GameScreen.Leaderboard:
            <LeaderboardView @ref="leaderboard" />
            break;

        case GameScreen.BattleArena:
            <BossBattle Start="bossBattle" OnBattleStarted="StartBossBattle" />
            break;
    }
</div>
