@page "/"
@using Game.Client.Services
@using System.Net
@using System.Net.Http.Headers
@inject GameState State
@inject HttpClient Http
@inject TokenRefresher Tokens
@inject SoundEffects Sounds
@inject LiveLobby Lobby
@implements IDisposable

<div class="game-client-shell">

    <!-- HEADER BAR: PERMANENTLY DISPLAYS GAME IDENTITY & STATUS ONCE LOGGED IN -->
    <div class="game-header">
        <h2 class="game-title">⚔️ KINGS OF THE CARD ARENA <a href="status" class="game-version" title="Build @AppVersion.Commit. Open the system status page.">@AppVersion.Number</a></h2>

        @if (State.CurrentScreen != GameScreen.LoginMenu)
        {
            <div class="game-status">
                <img src="@Avatars.For(State.AvatarUrl, State.Username)" alt="" class="header-avatar"
                     style="@CosmeticStyles.Frame(State.Frame, 2, "2px solid #818cf8")" />
                <span class="header-name">@State.Username</span>
                <span class="header-class" title="Your class">@HeroClassIcons.For(State.HeroClass) @State.HeroClass</span>
                <span class="header-gold">🪙 @State.Gold</span>


                <span
                    class="header-level">LVL
                    @State.Level</span>

                    <!-- Inside the top header row, append action links next to Logout -->
                    <button @onclick='() => State.ChangeScreen(GameScreen.CharacterDashboard)' class="header-button header-town">🏰 Town Dashboard</button>
                    <button @onclick="LaunchLeaderboardView" class="header-button header-leaderboards">🏆 Leaderboards</button>

                    <button @onclick="Sounds.ToggleAsync" title="@(Sounds.Enabled ? "Turn sound effects off" : "Turn sound effects on")"
                            aria-label="@(Sounds.Enabled ? "Turn sound effects off" : "Turn sound effects on")"
                            class="header-button header-sound">@(Sounds.Enabled ? "🔊" : "🔇")</button>

                    <button @onclick="Logout"
                            class="header-button header-logout">Logout</button>
                </div>
            }
        </div>

        <!-- DYNAMIC CORE CLIENT SCREEN SWITCH -->
        @switch (State.CurrentScreen)
        {
            case GameScreen.LoginMenu:
                <!-- RENDERS LOGIN / ACCOUNT CREATION SIMULTANEOUSLY -->
                <div class="login-pulse"><LivePulse /></div>
                <div
                    class="arena-panel login-panel">
                    <h3 class="login-heading">@(creatingHero ? "Create a New Hero" : "Enter the Realm")</h3>

                    <!-- A FORM SO PRESSING ENTER IN EITHER FIELD SIGNS IN (OR CREATES THE HERO) -->
                    <form @onsubmit="SubmitCredentials">
                    <div class="login-field login-field-first">
                        <label
                            class="field-label">Character
                            Name:</label>
                            <input type="text" @bind="inputUsername" @bind:event="oninput" placeholder="Enter Character name..." autocomplete="username"
                                   class="login-input" />
                        </div>

                    <div class="login-field login-password">
                        <label for="sign-in-password"
                            class="field-label">Password:</label>
                            <PasswordInput id="sign-in-password" @bind-Value="inputPassword" placeholder="At least 8 characters..." autocomplete="@(creatingHero ? "new-password" : "current-password")" />
                        </div>

                    @if (askForTwoFactorCode && !creatingHero)
                    {
                        <!-- HEROES WITH TWO-FACTOR SIGN-IN ON: THE PASSWORD WAS RIGHT, NOW THE CODE FROM THEIR APP -->
                        <div class="login-field">
                            <label for="sign-in-code"
                                   class="field-label">Code from your authenticator app:</label>
                            <input id="sign-in-code" @ref="twoFactorInput" @bind="inputTwoFactorCode" @bind:event="oninput" autocomplete="one-time-code" aria-describedby="sign-in-code-hint"
                                   class="login-input login-code-input" />
                            <p id="sign-in-code-hint" class="code-hint">Lost your phone? Enter one of your recovery codes instead.</p>
                        </div>
                    }

                    @if (creatingHero)
                    {
                        <!-- ONLY NEW HEROES PICK A CLASS; RETURNING HEROES KEEP THEIRS -->
                        <ClassPicker @bind-Selected="chosenClass" Heading="Choose your class:" />
                        <p class="terms-note">
                            By creating a hero you agree to the <a href="terms" class="soft-link">Terms of Service</a>
                            and <a href="privacy" class="soft-link">Privacy Policy</a>.
                        </p>
                        <button type="submit" disabled="@(!CredentialsEntered)"
                                class="login-submit create-submit @(CredentialsEntered ? "" : "is-waiting")">Create Hero</button>
                    }
                    else
                    {
                        <button type="submit" disabled="@(!CredentialsEntered)"
                                class="login-submit play-submit @(CredentialsEntered ? "" : "is-waiting")">Play Game</button>
                        <FeatureGate Feature="@FeatureFlags.AccountRecovery">
                            <p class="forgot-line"><a href="forgot-password" class="soft-link forgot-link">Forgot your password?</a></p>
                        </FeatureGate>
                    }
                    </form>
                    <p class="switch-line">
                        @(creatingHero ? "Already have a hero?" : "New to the arena?")
                        <button @onclick="ToggleCreatingHero" class="switch-button">
                            @(creatingHero ? "Sign in" : "Create a new hero")
                        </button>
                    </p>

                    <!-- ONE CLICK TO TRY THE GAME: A GUEST HERO, KEPT LATER WITH A NAME AND PASSWORD IF THE PLAYER LIKES IT -->
                    <div aria-hidden="true" class="or-divider">
                        <span class="or-rule"></span>or<span class="or-rule"></span>
                    </div>
                    <button @onclick="PlayAsGuest" disabled="@startingGuest"
                            class="guest-button">
                        @(startingGuest ? "Starting..." : "⚡ Play as a guest")
                    </button>
                    <p class="guest-note">
                        No sign-up. Keep your hero later if you like it. By playing you agree to the
                        <a href="terms" class="soft-link">Terms</a> and <a href="privacy" class="soft-link">Privacy Policy</a>.
                    </p>

                            @if (!string.IsNullOrEmpty(statusMsg) || !string.IsNullOrEmpty(State.SignOutReason))
                            {
                                <div
                                    class="login-error">
                                    @(string.IsNullOrEmpty(statusMsg) ? State.SignOutReason : statusMsg)
                                </div>
                            }
                        </div>
                        break;

        case GameScreen.CharacterDashboard:
                            <!-- RENDERS TOWN INVENTORY AND AVATAR FILE UPLOADER -->
                            <div class="town-column">
                                <LivePulse />

                                <!-- CHARACTER CARD BOX -->
                                <div class="arena-panel hero-card">
                                    <img src="@Avatars.For(State.AvatarUrl, State.Username)" alt="@($"{State.Username}'s portrait")" class="hero-portrait"
                                         style="@CosmeticStyles.Frame(State.Frame, 5, "4px solid #6366f1")" />
                                    <h2 class="hero-name">@State.Username</h2>
                                    @if (State.IsGuest)
                                    {
                                        <KeepGuestHero />
                                    }
                                    <button @onclick="OpenPortraitPopup"
                                            class="portrait-button">
                                        🖼️ Change portrait
                                    </button>
                                    <ClassSwitcher />

                                    <button @onclick="() => EnterArena()"
                                            class="town-action town-battle">
                                        ⚔️ LAUNCH BATTLE ARENA
                                    </button>
                                    <FeatureGate Feature="@FeatureFlags.Duels">
                                        <ChildContent>
                                            <button @onclick="() => State.ChangeScreen(GameScreen.PvpArena)"
                                                    class="town-action town-duel">
                                                🆚 FIND AN OPPONENT
                                            </button>
                                        </ChildContent>
                                        <Off><p class="closed-note">🆚 Duels are closed for now. Check back soon!</p></Off>
                                    </FeatureGate>
                                    <FeatureGate Feature="@FeatureFlags.GoldShop">
                                        <ChildContent>
                                            <button @onclick="() => State.ChangeScreen(GameScreen.Shop)"
                                                    class="town-action town-shop">
                                                🪙 GOLD SHOP
                                            </button>
                                        </ChildContent>
                                        <Off><p class="closed-note">🪙 The Gold Shop is closed for now. Check back soon!</p></Off>
                                    </FeatureGate>
                                    <FeatureGate Feature="@FeatureFlags.HeroicBoss">
                                        <HeroicChallenge OnFight="() => EnterArena(heroic: true)" />
                                    </FeatureGate>
                                    @if (!string.IsNullOrEmpty(statusMsg))
                                    {
                                        <p class="town-error">@statusMsg</p>
                                    }
                                    @if (!State.IsGuest)
                                    {
                                        <!-- A GUEST HAS NO PASSWORD TO CONFIRM CHANGES WITH; KEEPING THE HERO COMES FIRST -->
                                        <AccountSettings />
                                    }
                                    @if (State.IsAdmin)
                                    {
                                        <a href="admin" class="admin-link">🛡️ Admin tools</a>
                                    }
                                </div>

                            </div>

                            @if (showPortraitPopup)
                            {
                                <!-- PORTRAIT UPLOAD POPUP -->
                                <div role="dialog" aria-modal="true" aria-labelledby="portrait-title" @onclick="ClosePortraitPopup" @onkeydown="PortraitPopupKeyDown"
                                     class="portrait-backdrop">
                                    <div @onclick:stopPropagation="true"
                                         class="portrait-dialog">
                                        <div class="portrait-dialog-head">
                                            <h4 id="portrait-title" class="portrait-title">🛡️ Change portrait</h4>
                                            <button aria-label="Close" @onclick="ClosePortraitPopup" @ref="portraitCloseButton"
                                                    class="portrait-close">✕</button>
                                        </div>
                                        <p class="portrait-hint">PNG or JPG, up to 4 MB.</p>
                                        <InputFile OnChange="HandleFileSelected" accept=".png,.jpg,.jpeg" aria-label="Portrait image (PNG or JPG)" />
                                        @if (!string.IsNullOrEmpty(uploadError))
                                        {
                                            <p class="upload-error">@uploadError</p>
                                        }
                                        <button @onclick="ExecuteAvatarUpload" disabled="@(selectedFile == null || uploading)"
                                                class="upload-button @(selectedFile == null || uploading ? "is-waiting" : "")">
                                            @(uploading ? "Uploading..." : "Save portrait")
                                        </button>
                                    </div>
                                </div>
                            }
                                <SeasonCard />
                                <FriendsPanel />
                                <BountyBoard />
                                <RecentMatches />
                                break;


        case GameScreen.PvpArena:
                                <PvpArena />
                                break;

        case GameScreen.Shop:
                                <Shop />
                                break;

        case GameScreen.Leaderboard:
                                <!-- RENDERS DYNAMIC CARD ARENA ROSTER RANKINGS -->
                                <div class="arena-panel leaderboard-panel">
                                    <div class="leaderboard-intro">
                                        <h3 class="leaderboard-heading">🏆 GLOBAL HERO RANKINGS</h3>
                                        <p class="leaderboard-subtitle">@(leaderboardClass is null
                                            ? "Ranked by PvP rating: beat stronger heroes to climb faster"
                                            : $"Duels fought as a {leaderboardClass}, ranked by wins")</p>
                                        @if (registeredPlayers is { } total)
                                        {
                                            <p class="registered-count">👥 @total.ToString("N0") registered hero@(total == 1 ? "" : "es")</p>
                                        }
                                    </div>

                                    <LivePulse />
                                    <ArenaStats />
                                    @* Said once, politely, when a match elsewhere reorders the table. *@
                                    <p class="visually-hidden" aria-live="polite">@(leaderboardUpdatedLive ? "The rankings were just updated." : "")</p>

                                    <!-- ALL HEROES, OR ONE CLASS'S DUEL RECORDS -->
                                    <div role="tablist" class="leaderboard-tabs">
                                        @foreach (var tab in LeaderboardTabs)
                                        {
                                            var active = tab == leaderboardClass;
                                            <button role="tab" aria-selected="@(active ? "true" : "false")" @onclick="() => ShowLeaderboard(tab)"
                                                    class="leaderboard-tab @(active ? "is-active" : "")">
                                                @(tab is null ? "🌐 All" : $"{HeroClassIcons.For(tab)} {tab}")
                                            </button>
                                        }
                                    </div>

                                    @if (leaderboardLoading)
                                    {
                                        <p class="leaderboard-loading">Querying relational data graphs...</p>
                                    }
                                    else if (leaderboardPlayers == null || !leaderboardPlayers.Any())
                                    {
                                        <p class="leaderboard-empty">@(leaderboardClass is null ? "No heroes have claimed records inside the arena yet." : $"No {leaderboardClass} has fought a duel yet.")</p>
                                    }
                                    else
                                    {
                                        <div class="leaderboard-scroll">
                                            <table class="leaderboard-table">
                                                <thead>
                                                    <tr class="leaderboard-head-row">
                                                        <th>Rank</th>
                                                        <th>Hero</th>
                                                        <th class="col-center">Rating</th>
                                                        <th class="col-center">Level</th>
                                                        <th class="col-center">@(leaderboardClass is null ? "Duels W-L" : $"{leaderboardClass} W-L")</th>
                                                        <th class="col-right">Gold Reserves</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < leaderboardPlayers.Count; i++)
                                                    {
                                                        var item = leaderboardPlayers[i];
                                                        var isCurrentUser = item.id == State.PlayerId;

                                                        <tr class="leaderboard-row @(isCurrentUser ? "is-current" : "")">
                                                            <td class="rank-cell @(i == 0 ? "rank-first" : i == 1 ? "rank-second" : i == 2 ? "rank-third" : "")">
                                                                @(i + 1) @(i == 0 ? "👑" : "")
                                                            </td>
                                                            <td class="hero-cell">
                                                                <img src="@Avatars.For(item.avatarUrl, item.username)" alt="" class="leaderboard-avatar" style="@CosmeticStyles.Frame(item.frame, 2, "1px solid #475569")" />
                                                                <span class="leaderboard-name @(isCurrentUser ? "is-you" : "")">@item.username @(isCurrentUser ? " (You)" : "")</span>
                                                                @if (item.heroClass is { } heroClass)
                                                                {
                                                                    <span title="Plays @heroClass now">@HeroClassIcons.For(heroClass)</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(item.title))
                                                                {
                                                                    <span class="leaderboard-title">@item.title</span>
                                                                }
                                                                @if (!isCurrentUser)
                                                                {
                                                                    <span class="report-slot"><ReportHero HeroId="item.id" HeroName="@item.username" HasPortrait="@(!string.IsNullOrEmpty(item.avatarUrl))" /></span>
                                                                }
                                                            </td>
                                                            <td class="rating-cell">🏅 @item.rating</td>
                                                            <td class="level-cell">@item.level</td>
                                                            <td class="duels-cell">⚔️ @item.pvpWins-@item.pvpLosses</td>
                                                            <td class="gold-cell">🪙 @item.gold</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <SeasonStandings RefreshedAt="leaderboardMatchesUpTo" />
                                </div>
                                break;



        case GameScreen.BattleArena:
                                    <!-- RENDERS THE INTERACTIVE TURN-BASED COMBAT GAME CANVAS -->
                                    <div class="arena-panel battle-panel">
                                        <div class="arena-head">
                                            <h3 class="boss-name @(heroic ? "is-heroic" : "")">@(heroic ? "👑" : "😈") Boss: @bossName</h3>
                                            <div class="arena-hp">
                                                @if (bossEnraged)
                                                {
                                                    <span title="Below @enrageBelowPercent% health the boss's attacks hit 50% harder." class="enraged-badge">😡 ENRAGED</span>
                                                }
                                                <span class="boss-hp">Boss HP: @enemyHp / @enemyMaxHp</span>
                                                <span class="player-hp">@HeroClassIcons.For(State.HeroClass) Your HP: @playerHp / @playerMaxHp</span>
                                            </div>
                                        </div>

                                        @if (battleResult is null)
                                        {
                                            <!-- THE BOSS ANNOUNCES ITS NEXT MOVE SO THE PLAYER CAN PLAN AROUND IT -->
                                            <div class="boss-intent">
                                                @BossMoveIcon(bossNextMove) Next boss move: <strong>@bossNextMoveName</strong> for <strong>@enemyIntentAttack DMG</strong>
                                                @if (bossNextMove == "LifeDrain")
                                                {
                                                    <span> (heals the boss)</span>
                                                }
                                            </div>
                                        }

                                        <!-- COMBAT EVENTS LOGGER FEED (column-reverse keeps the scroll pinned to the newest line, so the lines are rendered in reverse) -->
                                        <div role="log" aria-label="Battle log" tabindex="0"
                                            class="battle-log">
                                            @foreach (var log in Enumerable.Reverse(logs))
                                            {
                                                <div>@log</div>
                                            }
                                        </div>

                                        @if (battleResult is null)
                                        {
                                        <!-- DECK ACTION HAND CARD PANELS -->
                                        <div class="card-hand">
                                            @foreach (var card in ArenaCards.Hand)
                                            {
                                                var recharging = rechargingCard == card.Id;
                                                var held = heldCards.FirstOrDefault(c => c.card == card.Id);
                                                var signature = HeroClassIcons.SignatureCard(State.HeroClass) == card.Id;
                                                <button class="hand-card @(signature ? "is-signature" : "") @(recharging ? "is-recharging" : "")" @onclick="() => PlayTurn(card.Id)" disabled="@recharging"
                                                        title="@(signature ? $"{State.HeroClass} signature card. {card.Hint}" : card.Hint)"
                                                        style="--card-bg: @CosmeticStyles.CardBackground(State.CardSkin, card.Color)">
                                                    @if (signature)
                                                    {
                                                        <span class="signature-badge">@HeroClassIcons.For(State.HeroClass)</span>
                                                    }
                                                    @card.Icon @card.Label@(held is { level: > 1 } ? $" ★{held.level}" : "")<br /><small>@(held is null ? card.Effect : ArenaCards.EffectOf(held.damage, held.heal))</small><br />
                                                    <small class="card-risk">@(recharging ? "⏳ Recharging" : held is null ? card.Risk : ArenaCards.RiskOf(card.Id, held.failChance))</small>
                                                </button>
                                            }
                                                    </div>
                                        }
                                        else
                                        {
                                            <!-- BATTLE RESULT PANEL: SHOWS THE SERVER'S VERDICT AND THE REWARDS EARNED -->
                                            <div class="battle-result @(battleResult.won ? "is-won" : "is-lost")">
                                                <div class="result-icon">@(battleResult.won ? "🏆" : "💀")</div>
                                                <h2 class="result-title @(battleResult.won ? "is-won" : "is-lost")">@(battleResult.won ? "VICTORY" : "DEFEAT")</h2>
                                                <p class="result-summary">
                                                    @(battleResult.won ? $"{bossName} has fallen!" : $"{bossName} prevails... this time.")
                                                </p>

                                                <div class="reward-line">
                                                    <span class="reward-gold">🪙 +@battleResult.goldEarned Gold</span>
                                                    <span class="reward-xp">✨ +@battleResult.experienceEarned XP</span>
                                                </div>

                                                <RewardBonuses StreakBonus="battleResult.streakBonus" Bounties="battleResult.bounties" />

                                                @if (heroic && battleResult.won)
                                                {
                                                    <div class="result-note">@(battleResult.reducedBossReward
                                                        ? "You've already claimed today's Heroic reward, so this win paid 25 gold. It comes back tomorrow."
                                                        : "👑 Heroic victory! That was today's Heroic reward; it comes back tomorrow.")</div>
                                                }
                                                else if (battleResult.reducedBossReward)
                                                {
                                                    <div class="result-note">You've used today's 5 full-reward boss wins, so this one paid 25 gold. Full rewards come back tomorrow.</div>
                                                }
                                                else if (battleResult.won && battleResult.fullRewardWinsLeft is { } left)
                                                {
                                                    <div class="result-note">@(left == 0 ? "That was your last full-reward boss win today." : $"{left} full-reward boss win{(left == 1 ? "" : "s")} left today.")</div>
                                                }

                                                @if (battleResult.leveledUp)
                                                {
                                                    <div class="level-up">⬆️ LEVEL UP! You are now level @battleResult.newLevel.</div>
                                                }

                                                <div class="result-actions">
                                                    <button @onclick="ReturnToTown"
                                                            class="result-button result-town">🏰 Return to Town</button>
                                                    <button @onclick="() => EnterArena(heroic)"
                                                            class="result-button result-again">⚔️ Fight Again</button>
                                                </div>
                                            </div>
                                        }
                                                </div>
                                                break;
                                            }
                                        </div>

@code {
    private string inputUsername = string.Empty;
    private string inputPassword = string.Empty;
    private string chosenClass = "Sorcerer";
    private bool creatingHero; // The sign-in screen is creating a new hero rather than signing in
    private bool startingGuest;

    private string inputTwoFactorCode = string.Empty;
    private bool askForTwoFactorCode; // The password was right and the hero has two-factor sign-in on
    private bool focusTwoFactorInput;
    private ElementReference twoFactorInput;

    private void ToggleCreatingHero()
    {
        creatingHero = !creatingHero;
        statusMsg = string.Empty;
    }
    private string statusMsg = string.Empty;
    private bool uploading = false;
    private IBrowserFile? selectedFile;
    private bool showPortraitPopup;
    private ElementReference portraitCloseButton;
    private bool focusPortraitPopup;
    private string uploadError = string.Empty;

    private void OpenPortraitPopup()
    {
        selectedFile = null;
        uploadError = string.Empty;
        showPortraitPopup = true;
        focusPortraitPopup = true; // keyboard and screen-reader users land inside the popup
    }

    private void PortraitPopupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePortraitPopup();
    }

    private void ClosePortraitPopup()
    {
        if (!uploading) showPortraitPopup = false;
    }

    // Arena State (mirrors the server's battle; the server decides every outcome)
    private Guid battleId;
    private int playerHp = 100;
    private int playerMaxHp = 100; // More than 100 when a Battle Elixir was drunk
    private List<BattleCardDto> heldCards = new(); // The cards as upgraded in the Gold Shop
    private int enemyHp = 160;
    private int enemyMaxHp = 160;
    private bool heroic; // Fighting the Heroic boss, for players with every card maxed out
    private string bossName = "The Shadow Overlord";
    private int enrageBelowPercent = 40;
    private bool bossEnraged; // Below 40% health the boss's attacks hit 50% harder
    private int enemyIntentAttack = 15; // Damage of the boss's announced move
    private string bossNextMove = "Slash";
    private string bossNextMoveName = "Slash";
    private string? rechargingCard; // Dragon Claw and Holy Shield can't be played two turns in a row
    private int turnCount = 1;
    private bool isPlayerTurn = true; // Prevents button click spamming
    private bool matchConcluding = false; // Locks inputs during network saves
    private BattleResultView? battleResult; // Set when the server ends the battle
    private List<string> logs = new() { "⚔️ Match Initialized. Select an action card block." };

    // Leaderboard state references
    private bool leaderboardLoading = false;
    private List<PlayerProfileDto>? leaderboardPlayers;
    private int? registeredPlayers;
    // The latest match the shown rankings include, from the live lobby feed; a newer one reloads them.
    private DateTime? leaderboardMatchesUpTo;
    private bool leaderboardUpdatedLive;

    protected override void OnInitialized()
    {
        State.OnStateChanged += StateHasChanged;
        Sounds.OnChanged += StateHasChanged;
        Lobby.Changed += OnLobbyChanged;
    }

    private void OnLobbyChanged() => _ = InvokeAsync(async () =>
    {
        var latest = Lobby.Current?.LeaderboardUpdatedAt;
        if (State.CurrentScreen != GameScreen.Leaderboard || leaderboardLoading || latest is null || latest == leaderboardMatchesUpTo) return;
        await ShowLeaderboard(leaderboardClass, quietly: true);
        leaderboardUpdatedLive = true;
        StateHasChanged();
    });

    // The saved sound setting lives in the browser, which is only reachable after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Sounds.LoadAsync();
        if (focusTwoFactorInput)
        {
            focusTwoFactorInput = false;
            await twoFactorInput.FocusAsync();
        }
        if (focusPortraitPopup)
        {
            focusPortraitPopup = false;
            await portraitCloseButton.FocusAsync();
        }
    }

    // Play Game / Create Hero stay disabled until both fields have something in them.
    private bool CredentialsEntered => !string.IsNullOrWhiteSpace(inputUsername) && !string.IsNullOrEmpty(inputPassword);

    private Task SubmitCredentials() => creatingHero ? HandleRegister() : HandleLogin();

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(inputUsername) || string.IsNullOrEmpty(inputPassword)) return;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v1/auth/login", new
            {
                Username = inputUsername,
                Password = inputPassword,
                TwoFactorCode = askForTwoFactorCode ? inputTwoFactorCode : null
            });
            if (res.IsSuccessStatusCode)
            {
                await StartSession(res);
            }
            else if (res.StatusCode == HttpStatusCode.Unauthorized && await ReadProblem(res) is { twoFactorRequired: true } problem)
            {
                // Show the code box; only say something's wrong if a code was already tried.
                statusMsg = askForTwoFactorCode ? problem.detail ?? "That code isn't right." : string.Empty;
                askForTwoFactorCode = focusTwoFactorInput = true;
                inputTwoFactorCode = string.Empty;
            }
            else if (res.StatusCode == HttpStatusCode.Forbidden)
            {
                // Suspended by an admin: the API says until when and why.
                statusMsg = await ReadProblemDetail(res) ?? "This hero is suspended.";
            }
            else statusMsg = res.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Wrong character name or password.",
                HttpStatusCode.Locked => "Too many failed attempts. Try again in a few minutes.",
                _ => "Sign-in failed. Please try again."
            };
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(inputUsername) || string.IsNullOrEmpty(inputPassword)) return;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v1/auth/register", new { Username = inputUsername, Password = inputPassword, Class = chosenClass });
            if (res.IsSuccessStatusCode)
            {
                // Registration signs the new hero straight in.
                await StartSession(res);
            }
            else if (res.StatusCode == HttpStatusCode.Conflict) statusMsg = "Username already claimed inside database.";
            else statusMsg = await ReadValidationMessage(res);
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task PlayAsGuest()
    {
        startingGuest = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v1/auth/guest", new { Class = chosenClass });
            if (res.IsSuccessStatusCode) await StartSession(res);
            else statusMsg = res.StatusCode == HttpStatusCode.TooManyRequests
                ? "Lots of guests have started from your network this hour. Create a hero instead, or try again later."
                : "Couldn't start a guest hero. Please try again.";
        }
        catch { statusMsg = "API Network Link Offline."; }
        finally { startingGuest = false; }
    }

    private async Task StartSession(HttpResponseMessage res)
    {
        var auth = await res.Content.ReadFromJsonAsync<AuthResponseDto>();
        if (auth?.player is null) return;

        statusMsg = string.Empty;
        inputPassword = inputTwoFactorCode = string.Empty;
        askForTwoFactorCode = false;
        creatingHero = false;
        State.UpdateClass(auth.player.@class);
        State.SetPlayerSession(new SessionTokens(auth.accessToken, auth.expiresAt, auth.refreshToken), auth.player.id, auth.player.username, auth.player.gold, auth.player.level, auth.player.avatarUrl);
        State.UpdateCosmetics(auth.player.frame, auth.player.cardSkin);
        State.UpdateGuest(auth.player.isGuest);
        State.UpdateRoles(auth.roles);
    }

    private static async Task<string?> ReadProblemDetail(HttpResponseMessage res) => (await ReadProblem(res))?.detail;

    private static async Task<ProblemDto?> ReadProblem(HttpResponseMessage res)
    {
        try
        {
            return await res.Content.ReadFromJsonAsync<ProblemDto>();
        }
        catch (System.Text.Json.JsonException) { return null; }
        catch (NotSupportedException) { return null; } // an empty or non-JSON body
    }

    // Turns an ASP.NET Core validation problem (e.g. password rules) into one readable line.
    private static async Task<string> ReadValidationMessage(HttpResponseMessage res)
    {
        try
        {
            var problem = await res.Content.ReadFromJsonAsync<ValidationProblemDto>();
            var messages = problem?.errors?.SelectMany(e => e.Value).ToList();
            if (messages is { Count: > 0 }) return string.Join(" ", messages);
        }
        catch (System.Text.Json.JsonException) { }
        return "Registration failed. Please check your details.";
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadError = string.Empty;
    }

    private async Task ExecuteAvatarUpload()
    {
        if (selectedFile == null) return;
        try
        {
            uploading = true;
            uploadError = string.Empty;
            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 4);
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(streamContent, "File", selectedFile.Name);

            var res = await Http.PostAsync("/api/v1/players/me/avatar", content);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<UploadResponse>();
                if (result != null) State.UpdateAvatar(result.avatarUrl);
                selectedFile = null;
                showPortraitPopup = false;
            }
            else uploadError = res.StatusCode switch
            {
                // The server says why: not a PNG or JPG, too big, or turned away by the content check.
                HttpStatusCode.BadRequest or HttpStatusCode.ServiceUnavailable => await ProblemText.ReadAsync(res)
                    ?? "That file couldn't be used. Pick a PNG or JPG under 4 MB.",
                HttpStatusCode.RequestEntityTooLarge => "That file couldn't be used. Pick a PNG or JPG under 4 MB.",
                HttpStatusCode.TooManyRequests => "You've changed your portrait a lot recently. Please try again later.",
                _ => "Upload failed. Please try again."
            };
        }
        catch { uploadError = "Upload failed. Make sure the file is a PNG or JPG under 4 MB and try again."; }
        finally { uploading = false; }
    }

    // --- ⚔️ SERVER-AUTHORITATIVE TURN-BASED COMBAT ---
    // The API owns the battle: we send the chosen card and replay what the server decided.
    private async Task EnterArena(bool heroic = false)
    {
        try
        {
            var res = await Http.PostAsync(heroic ? "/api/v1/battles/pve?difficulty=Heroic" : "/api/v1/battles/pve", null);
            if (!res.IsSuccessStatusCode)
            {
                statusMsg = res.StatusCode == HttpStatusCode.BadRequest
                    ? await ReadValidationMessage(res)
                    : "The arena gates are closed. Please try again.";
                return;
            }
            statusMsg = string.Empty;

            var battle = await res.Content.ReadFromJsonAsync<BattleStateDto>();
            if (battle is null) return;

            ResetMatch();
            ApplyBattleState(battle);
            if (res.StatusCode == HttpStatusCode.OK)
            {
                logs.Add($"↩️ Resuming your battle on turn {battle.turn}.");
            }
            State.ChangeScreen(GameScreen.BattleArena);
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task PlayTurn(string card)
    {
        if (!isPlayerTurn || matchConcluding || enemyHp <= 0 || playerHp <= 0) return;

        isPlayerTurn = false; // One card at a time: the next can be played once the server has answered
        FinishBossTurn();     // Playing on before the boss's turn has been told tells the rest of it at once

        PlayCardResponseDto? result;
        try
        {
            var res = await Http.PostAsJsonAsync($"/api/v1/battles/pve/{battleId}/turns", new { Card = card });
            if (!res.IsSuccessStatusCode)
            {
                logs.Add($"[API Rejection] The move was not accepted: {await res.Content.ReadAsStringAsync()}");
                isPlayerTurn = true;
                return;
            }
            result = await res.Content.ReadFromJsonAsync<PlayCardResponseDto>();
        }
        catch (Exception ex)
        {
            logs.Add($"[Network Error] Could not reach the arena: {ex.Message}");
            isPlayerTurn = true;
            return;
        }
        if (result is null) { isPlayerTurn = true; return; }

        var turn = result.turnResult;

        // 1. SHOW THE PLAYER'S CARD
        if (turn.cardFailed)
        {
            logs.Add($"🌀 Turn {turn.turn}: Your {turn.cardName} was {turn.cardFailedReason} by {bossName}!");
            _ = Sounds.PlayAsync(Sound.Miss);
        }
        else if (turn.damageDealt > 0)
        {
            enemyHp = Math.Max(0, enemyHp - turn.damageDealt);
            logs.Add($"» Turn {turn.turn}: You cast {turn.cardName} dealing {turn.damageDealt} DMG.");
            _ = Sounds.PlayAsync(SoundEffects.ForCard(turn.cardName));
        }
        else if (card == "HolyShield")
        {
            playerHp += turn.healthRestored;
            logs.Add($"» Turn {turn.turn}: You raise {turn.cardName} and recover {turn.healthRestored} HP.");
            _ = Sounds.PlayAsync(Sound.Shield);
        }

        // 2. THE BOSS'S COUNTER-ATTACK, TOLD AFTER A SHORT DRAMATIC PAUSE
        if (turn.bossDamage is int bossDamage)
        {
            logs.Add($"⏳ {bossName} winds up a {turn.bossMoveName}...");
            bossTurn.Enqueue(turn.attackBlocked
                ? new($"🛡️ Your shield blocks the {turn.bossMoveName}! No damage taken.", Sound.Block)
                : new($"💥 {turn.bossMoveName} hits you for {bossDamage} damage!", Sound.Hit));
            if (turn.bossHealed > 0)
            {
                bossTurn.Enqueue(new($"🩸 {bossName} drains {turn.bossHealed} HP back.", Sound.Drain));
            }
        }

        // 3. THE SERVER'S VERDICT: NEW HEALTH, THE BOSS'S NEXT MOVE, OR THE END OF THE FIGHT
        var wasEnraged = bossEnraged;
        bossTurn.Enqueue(new(null, Apply: quietly =>
        {
            ApplyBattleState(result.battle);
            if (result.battle.status != "InProgress")
            {
                HandleMatchResolution(result);
                return;
            }
            if (bossEnraged && !wasEnraged)
            {
                logs.Add($"😡 {bossName} is badly hurt and flies into a rage! Its attacks now hit 50% harder.");
                if (!quietly) _ = Sounds.PlayAsync(Sound.Drain);
            }
            logs.Add($"⚠️ {bossName} prepares {bossNextMoveName} for {enemyIntentAttack} DMG.");
        }));

        // 4. UNLOCK CONTROLS STRAIGHT AWAY: the card just played recharges, and any other can be played
        // while the boss's turn is still being told.
        rechargingCard = result.battle.rechargingCard;
        isPlayerTurn = result.battle.status == "InProgress";
        if (turn.bossDamage is null)
        {
            FinishBossTurn();
            return;
        }
        StateHasChanged(); // show the unlocked cards now, not when the pause is over
        await TellBossTurnAsync();
    }

    /// <summary>A line of the boss's turn, told after the pause; Apply runs first and is told whether sounds are skipped.</summary>
    private sealed record BossBeat(string? Log, Sound? Sound = null, Action<bool>? Apply = null);

    private static readonly TimeSpan BossTurnPause = TimeSpan.FromMilliseconds(900);
    private readonly Queue<BossBeat> bossTurn = new();
    private CancellationTokenSource? bossTurnPause;

    private async Task TellBossTurnAsync()
    {
        bossTurnPause = new CancellationTokenSource();
        try
        {
            await Task.Delay(BossTurnPause, bossTurnPause.Token);
        }
        catch (TaskCanceledException)
        {
            return; // the player played on; FinishBossTurn told the rest
        }
        TellBossTurn(quietly: false);
        StateHasChanged();
    }

    /// <summary>Tells whatever is left of the boss's turn at once, without its sounds.</summary>
    private void FinishBossTurn()
    {
        bossTurnPause?.Cancel();
        bossTurnPause = null;
        TellBossTurn(quietly: true);
    }

    private void TellBossTurn(bool quietly)
    {
        while (bossTurn.TryDequeue(out var beat))
        {
            beat.Apply?.Invoke(quietly);
            if (beat.Log is not null) logs.Add(beat.Log);
            if (!quietly && beat.Sound is { } sound) _ = Sounds.PlayAsync(sound);
        }
    }

    private void ApplyBattleState(BattleStateDto battle)
    {
        battleId = battle.id;
        playerHp = battle.playerHp;
        playerMaxHp = battle.playerMaxHp;
        heldCards = battle.cards;
        enemyHp = battle.bossHp;
        enemyMaxHp = battle.bossMaxHp;
        heroic = battle.difficulty == "Heroic";
        bossName = battle.bossName;
        enrageBelowPercent = battle.enrageBelowPercent;
        bossEnraged = battle.bossEnraged;
        enemyIntentAttack = battle.bossNextAttack;
        bossNextMove = battle.bossNextMove;
        bossNextMoveName = battle.bossNextMoveName;
        rechargingCard = battle.rechargingCard;
        turnCount = battle.turn;
    }

    private void HandleMatchResolution(PlayCardResponseDto result)
    {
        matchConcluding = true; // Lock all inputs

        var won = result.battle.status == "Won";
        _ = Sounds.PlayAsync(won ? Sound.Victory : Sound.Defeat);
        logs.Add(won
            ? "🏆 VICTORY! The server confirmed your win."
            : $"💀 DEFEAT! {bossName} prevails.");

        var levelBefore = State.Level;
        if (result.reward is { } reward)
        {
            logs.Add($"🪙 +{reward.goldEarned} gold, +{reward.experienceEarned} XP.");
            if (reward.streakBonus > 0) logs.Add($"🔥 Win streak bonus: +{reward.streakBonus} gold.");
            foreach (var bounty in reward.bountiesCompleted) logs.Add($"📜 Bounty complete: {bounty.name} (+{bounty.reward} gold).");
            // Sync the header with the balances the server just saved
            State.UpdateRewards(reward.player.gold, reward.player.level);
        }

        // Stay in the arena and show the result until the player chooses what to do next
        battleResult = new BattleResultView(
            won,
            result.reward?.goldEarned ?? 0,
            result.reward?.experienceEarned ?? 0,
            State.Level > levelBefore,
            State.Level,
            result.reward?.streakBonus ?? 0,
            result.reward?.bountiesCompleted.Select(b => new RewardBonuses.BountyLine(b.name, b.reward)).ToList() ?? [],
            result.reward?.reducedBossReward ?? false,
            result.reward?.fullRewardBossWinsLeft);
        StateHasChanged();
    }

