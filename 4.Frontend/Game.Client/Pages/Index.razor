@page "/"
@using Game.Client.Services
@using System.Net
@using System.Net.Http.Headers
@inject GameState State
@inject HttpClient Http
@inject TokenRefresher Tokens
@inject SoundEffects Sounds
@implements IDisposable

<div class="game-client-shell"
     style="background: #0f172a; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; color: #f8fafc;">
    
    <!-- HEADER BAR: PERMANENTLY DISPLAYS GAME IDENTITY & STATUS ONCE LOGGED IN -->
    <div
        style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #334155; padding-bottom: 15px; margin-bottom: 25px;">
        <h2 style="margin: 0; color: #818cf8; font-weight: 800; tracking: wide;">⚔️ KINGS OF THE CARD ARENA <a href="status" style="font-size: 0.8rem; font-weight: 600; color: #94a3b8;" title="Build @AppVersion.Commit. Open the system status page.">@AppVersion.Number</a></h2>
        
        @if (State.CurrentScreen != GameScreen.LoginMenu)
        {
            <div
                style="display: flex; align-items: center; gap: 20px; background: #1e293b; padding: 8px 20px; border-radius: 30px; border: 1px solid #475569;">
                <img src="@Avatars.For(State.AvatarUrl, State.Username)" alt=""
                     style="width: 35px; height: 35px; border-radius: 50%; @CosmeticStyles.Frame(State.Frame, 2, "2px solid #818cf8") object-fit: cover;" />
                <span style="font-weight: bold; color: #f1f5f9;">@State.Username</span>
                <span style="color: #c7d2fe; font-size: 0.9rem; white-space: nowrap;" title="Your class">@HeroClassIcons.For(State.HeroClass) @State.HeroClass</span>
                <span style="color: #fbbf24; font-weight: bold;">🪙 @State.Gold</span>


                <span
                    style="background: #4f46e5; padding: 2px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: bold;">LVL
                    @State.Level</span>

                    <!-- Inside the top header row, append action links next to Logout -->
                    <button @onclick='() => State.ChangeScreen(GameScreen.CharacterDashboard)' style="background: transparent; color: #818cf8; border: none; cursor: pointer; font-size: 0.9rem; font-weight: bold; margin-right: 10px;">🏰 Town Dashboard</button>
                    <button @onclick="LaunchLeaderboardView" style="background: transparent; color: #fbbf24; border: none; cursor: pointer; font-size: 0.9rem; font-weight: bold; margin-right: 10px;">🏆 Leaderboards</button>

                    <button @onclick="Sounds.ToggleAsync" title="@(Sounds.Enabled ? "Turn sound effects off" : "Turn sound effects on")"
                            aria-label="@(Sounds.Enabled ? "Turn sound effects off" : "Turn sound effects on")"
                            style="background: transparent; border: none; cursor: pointer; font-size: 1.1rem; margin-right: 10px;">@(Sounds.Enabled ? "🔊" : "🔇")</button>

                    <button @onclick="Logout"
                            style="background: transparent; color: #94a3b8; border: none; cursor: pointer; font-size: 0.9rem; font-weight: bold;">Logout</button>
                </div>
            }
        </div>

        <!-- DYNAMIC CORE CLIENT SCREEN SWITCH -->
        @switch (State.CurrentScreen)
        {
            case GameScreen.LoginMenu:
                <!-- RENDERS LOGIN / ACCOUNT CREATION SIMULTANEOUSLY -->
                <div
                    style="max-width: 450px; margin: 60px auto; background: #1e293b; padding: 35px; border-radius: 16px; border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);">
                    <h3 style="text-align: center; margin-top: 0; color: #f1f5f9;">@(creatingHero ? "Create a New Hero" : "Enter the Realm")</h3>
                
                    <!-- A FORM SO PRESSING ENTER IN EITHER FIELD SIGNS IN (OR CREATES THE HERO) -->
                    <form @onsubmit="SubmitCredentials">
                    <div style="margin-bottom: 20px; margin-top: 25px;">
                        <label
                            style="display: block; margin-bottom: 8px; font-weight: bold; color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">Character
                            Name:</label>
                            <input type="text" @bind="inputUsername" @bind:event="oninput" placeholder="Enter Character name..." autocomplete="username"
                                   style="width: 100%; padding: 12px; background: #0f172a; border: 1px solid #475569; border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box;" />
                        </div>

                    <div style="margin-bottom: 20px;">
                        <label
                            style="display: block; margin-bottom: 8px; font-weight: bold; color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">Password:</label>
                            <input type="password" @bind="inputPassword" @bind:event="oninput" placeholder="At least 8 characters..." autocomplete="@(creatingHero ? "new-password" : "current-password")"
                                   style="width: 100%; padding: 12px; background: #0f172a; border: 1px solid #475569; border-radius: 8px; color: white; font-size: 1rem; box-sizing: border-box;" />
                        </div>

                    @if (creatingHero)
                    {
                        <!-- ONLY NEW HEROES PICK A CLASS; RETURNING HEROES KEEP THEIRS -->
                        <ClassPicker @bind-Selected="chosenClass" Heading="Choose your class:" />
                        <button type="submit" disabled="@(!CredentialsEntered)"
                                style="width: 100%; background: #047857; color: white; padding: 12px; border: none; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: @(CredentialsEntered ? "pointer" : "not-allowed"); opacity: @(CredentialsEntered ? "1" : "0.5");">Create Hero</button>
                    }
                    else
                    {
                        <button type="submit" disabled="@(!CredentialsEntered)"
                                style="width: 100%; background: #4f46e5; color: white; padding: 12px; border: none; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: @(CredentialsEntered ? "pointer" : "not-allowed"); opacity: @(CredentialsEntered ? "1" : "0.5");">Play Game</button>
                    }
                    </form>
                    <p style="text-align: center; color: #94a3b8; font-size: 0.9rem; margin: 18px 0 0;">
                        @(creatingHero ? "Already have a hero?" : "New to the arena?")
                        <button @onclick="ToggleCreatingHero" style="background: transparent; border: none; color: #818cf8; cursor: pointer; font-weight: bold; text-decoration: underline; font-size: 0.9rem;">
                            @(creatingHero ? "Sign in" : "Create a new hero")
                        </button>
                    </p>

                            @if (!string.IsNullOrEmpty(statusMsg) || !string.IsNullOrEmpty(State.SignOutReason))
                            {
                                <div
                                    style="margin-top: 20px; padding: 12px; border-radius: 8px; text-align: center; font-weight: bold; font-size: 0.9rem; background: rgba(239,68,68,0.1); color: #f87171; border: 1px solid rgba(239,68,68,0.2);">
                                    @(string.IsNullOrEmpty(statusMsg) ? State.SignOutReason : statusMsg)
                                </div>
                            }
                        </div>
                        break;

        case GameScreen.CharacterDashboard:
                            <!-- RENDERS TOWN INVENTORY AND AVATAR FILE UPLOADER -->
                            <div style="max-width: 480px; margin: 0 auto;">
                
                                <!-- CHARACTER CARD BOX -->
                                <div
                                    style="background: #1e293b; padding: 30px; border-radius: 16px; border: 1px solid #334155; text-align: center;">
                                    <img src="@Avatars.For(State.AvatarUrl, State.Username)" alt="@($"{State.Username}'s portrait")"
                                         style="width: 160px; height: 160px; border-radius: 50%; @CosmeticStyles.Frame(State.Frame, 5, "4px solid #6366f1") object-fit: cover; background: #0f172a; margin-bottom: 15px;" />
                                    <h2 style="margin: 0; color: #f1f5f9;">@State.Username</h2>
                                    <button @onclick="OpenPortraitPopup"
                                            style="background: none; border: 1px solid #475569; color: #94a3b8; border-radius: 20px; padding: 4px 12px; font-size: 0.8rem; cursor: pointer; margin-top: 8px;">
                                        🖼️ Change portrait
                                    </button>
                                    <ClassSwitcher />
                    
                                    <button @onclick="() => EnterArena()"
                                            style="width: 100%; background: #dc2626; color: white; padding: 15px; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: bold; margin-top: 25px; cursor: pointer; box-shadow: 0 10px 15px -3px rgba(220,38,38,0.3);">
                                        ⚔️ LAUNCH BATTLE ARENA
                                    </button>
                                    <FeatureGate Feature="@FeatureFlags.Duels">
                                        <ChildContent>
                                            <button @onclick="() => State.ChangeScreen(GameScreen.PvpArena)"
                                                    style="width: 100%; background: #0e7490; color: white; padding: 15px; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: bold; margin-top: 15px; cursor: pointer; box-shadow: 0 10px 15px -3px rgba(14,116,144,0.3);">
                                                🆚 FIND AN OPPONENT
                                            </button>
                                        </ChildContent>
                                        <Off><p style="color: #94a3b8; font-size: 0.85rem; margin: 15px 0 0;">🆚 Duels are closed for now. Check back soon!</p></Off>
                                    </FeatureGate>
                                    <FeatureGate Feature="@FeatureFlags.GoldShop">
                                        <ChildContent>
                                            <button @onclick="() => State.ChangeScreen(GameScreen.Shop)"
                                                    style="width: 100%; background: #b45309; color: white; padding: 15px; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: bold; margin-top: 15px; cursor: pointer; box-shadow: 0 10px 15px -3px rgba(180,83,9,0.3);">
                                                🪙 GOLD SHOP
                                            </button>
                                        </ChildContent>
                                        <Off><p style="color: #94a3b8; font-size: 0.85rem; margin: 15px 0 0;">🪙 The Gold Shop is closed for now. Check back soon!</p></Off>
                                    </FeatureGate>
                                    <FeatureGate Feature="@FeatureFlags.HeroicBoss">
                                        <HeroicChallenge OnFight="() => EnterArena(heroic: true)" />
                                    </FeatureGate>
                                    @if (!string.IsNullOrEmpty(statusMsg))
                                    {
                                        <p style="color: #f87171; margin: 15px 0 0;">@statusMsg</p>
                                    }
                                    <AccountSettings />
                                </div>

                            </div>

                            @if (showPortraitPopup)
                            {
                                <!-- PORTRAIT UPLOAD POPUP -->
                                <div role="dialog" aria-modal="true" aria-labelledby="portrait-title" @onclick="ClosePortraitPopup" @onkeydown="PortraitPopupKeyDown"
                                     style="position: fixed; inset: 0; background: rgba(2,6,23,0.75); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 16px;">
                                    <div @onclick:stopPropagation="true"
                                         style="background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 24px; width: 100%; max-width: 380px; color: #f1f5f9;">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <h4 id="portrait-title" style="margin: 0; font-size: 1.1rem;">🛡️ Change portrait</h4>
                                            <button aria-label="Close" @onclick="ClosePortraitPopup" @ref="portraitCloseButton"
                                                    style="background: none; border: none; color: #94a3b8; font-size: 1.3rem; cursor: pointer;">✕</button>
                                        </div>
                                        <p style="color: #94a3b8; font-size: 0.85rem; margin: 8px 0 14px;">PNG or JPG, up to 5 MB.</p>
                                        <InputFile OnChange="HandleFileSelected" accept=".png,.jpg,.jpeg" aria-label="Portrait image (PNG or JPG)" style="color: #94a3b8; width: 100%;" />
                                        @if (!string.IsNullOrEmpty(uploadError))
                                        {
                                            <p style="color: #f87171; font-size: 0.85rem; margin: 10px 0 0;">@uploadError</p>
                                        }
                                        <button @onclick="ExecuteAvatarUpload" disabled="@(selectedFile == null || uploading)"
                                                style="width: 100%; background: #4f46e5; color: white; padding: 10px; border: none; border-radius: 8px; font-weight: bold; margin-top: 16px; cursor: @(selectedFile == null || uploading ? "not-allowed" : "pointer"); opacity: @(selectedFile == null || uploading ? "0.5" : "1");">
                                            @(uploading ? "Uploading..." : "Save portrait")
                                        </button>
                                    </div>
                                </div>
                            }
                                <BountyBoard />
                                <RecentMatches />
                                break;


        case GameScreen.PvpArena:
                                <PvpArena />
                                break;

        case GameScreen.Shop:
                                <Shop />
                                break;

        case GameScreen.Leaderboard:
                                <!-- RENDERS DYNAMIC CARD ARENA ROSTER RANKINGS -->
                                <div style="max-width: 800px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 16px; border: 1px solid #334155;">
                                    <div style="text-align: center; margin-bottom: 25px;">
                                        <h3 style="margin: 0; color: #fbbf24; font-size: 1.8rem; font-weight: 800;">🏆 GLOBAL HERO RANKINGS</h3>
                                        <p style="color: #94a3b8; font-size: 0.95rem; margin-top: 5px;">@(leaderboardClass is null
                                            ? "Ranked by PvP rating: beat stronger heroes to climb faster"
                                            : $"Duels fought as a {leaderboardClass}, ranked by wins")</p>
                                        @if (registeredPlayers is { } total)
                                        {
                                            <p style="color: #22d3ee; font-weight: bold; margin: 10px 0 0;">👥 @total.ToString("N0") registered hero@(total == 1 ? "" : "es")</p>
                                        }
                                    </div>

                                    <ArenaStats />

                                    <!-- ALL HEROES, OR ONE CLASS'S DUEL RECORDS -->
                                    <div role="tablist" style="display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
                                        @foreach (var tab in LeaderboardTabs)
                                        {
                                            var active = tab == leaderboardClass;
                                            <button role="tab" aria-selected="@(active ? "true" : "false")" @onclick="() => ShowLeaderboard(tab)"
                                                    style="background: @(active ? "#312e81" : "#0f172a"); color: @(active ? "white" : "#94a3b8"); border: 1px solid @(active ? "#818cf8" : "#334155"); border-radius: 20px; padding: 6px 14px; cursor: pointer; font-weight: bold;">
                                                @(tab is null ? "🌐 All" : $"{HeroClassIcons.For(tab)} {tab}")
                                            </button>
                                        }
                                    </div>

                                    @if (leaderboardLoading)
                                    {
                                        <p style="text-align: center; color: #94a3b8;">Querying relational data graphs...</p>
                                    }
                                    else if (leaderboardPlayers == null || !leaderboardPlayers.Any())
                                    {
                                        <p style="text-align: center; color: #f87171;">@(leaderboardClass is null ? "No heroes have claimed records inside the arena yet." : $"No {leaderboardClass} has fought a duel yet.")</p>
                                    }
                                    else
                                    {
                                        <div style="overflow-x: auto;">
                                            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 1rem;">
                                                <thead>
                                                    <tr style="border-bottom: 2px solid #334155; color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">
                                                        <th style="padding: 12px;">Rank</th>
                                                        <th style="padding: 12px;">Hero</th>
                                                        <th style="padding: 12px; text-align: center;">Rating</th>
                                                        <th style="padding: 12px; text-align: center;">Level</th>
                                                        <th style="padding: 12px; text-align: center;">@(leaderboardClass is null ? "Duels W-L" : $"{leaderboardClass} W-L")</th>
                                                        <th style="padding: 12px; text-align: right;">Gold Reserves</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < leaderboardPlayers.Count; i++)
                                                    {
                                                        var item = leaderboardPlayers[i];
                                                        var isCurrentUser = item.id == State.PlayerId;
                                                        
                                                        <tr style="border-bottom: 1px solid #334155; background: @(isCurrentUser ? "rgba(99,102,241,0.15)" : "transparent"); font-weight: @(isCurrentUser ? "bold" : "normal");">
                                                            <td style="padding: 14px; font-weight: bold; color: @(i == 0 ? "#fbbf24" : i == 1 ? "#cbd5e1" : i == 2 ? "#b45309" : "#94a3b8");">
                                                                @(i + 1) @(i == 0 ? "👑" : "")
                                                            </td>
                                                            <td style="padding: 14px; display: flex; align-items: center; gap: 12px;">
                                                                <img src="@Avatars.For(item.avatarUrl, item.username)" alt="" style="width: 30px; height: 30px; border-radius: 50%; @CosmeticStyles.Frame(item.frame, 2, "1px solid #475569") object-fit: cover;" />
                                                                <span style="color: @(isCurrentUser ? "#a5b4fc" : "#f1f5f9");">@item.username @(isCurrentUser ? " (You)" : "")</span>
                                                                @if (item.heroClass is { } heroClass)
                                                                {
                                                                    <span title="Plays @heroClass now">@HeroClassIcons.For(heroClass)</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(item.title))
                                                                {
                                                                    <span style="color: #fbbf24; font-size: 0.85rem; font-style: italic;">@item.title</span>
                                                                }
                                                            </td>
                                                            <td style="padding: 14px; text-align: center; color: #22d3ee; font-weight: bold;">🏅 @item.rating</td>
                                                            <td style="padding: 14px; text-align: center; color: #38bdf8; font-weight: bold;">@item.level</td>
                                                            <td style="padding: 14px; text-align: center; color: #cbd5e1; font-weight: bold;">⚔️ @item.pvpWins-@item.pvpLosses</td>
                                                            <td style="padding: 14px; text-align: right; color: #fbbf24; font-weight: bold;">🪙 @item.gold</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                break;



        case GameScreen.BattleArena:
                                    <!-- RENDERS THE INTERACTIVE TURN-BASED COMBAT GAME CANVAS -->
                                    <div
                                        style="max-width: 900px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 16px; border: 1px solid #334155;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                                            <h3 style="margin: 0; color: @(heroic ? "#f59e0b" : "#ef4444");">@(heroic ? "👑" : "😈") Boss: @bossName</h3>
                                            <div style="font-size: 1.2rem; font-weight: bold; white-space: nowrap;">
                                                @if (bossEnraged)
                                                {
                                                    <span title="Below @enrageBelowPercent% health the boss's attacks hit 50% harder." style="background: #7f1d1d; color: #fecaca; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem; margin-right: 12px;">😡 ENRAGED</span>
                                                }
                                                <span style="color: #ef4444; margin-right: 20px;">Boss HP: @enemyHp / @enemyMaxHp</span>
                                                <span style="color: #3b82f6;">@HeroClassIcons.For(State.HeroClass) Your HP: @playerHp / @playerMaxHp</span>
                                            </div>
                                        </div>

                                        @if (battleResult is null)
                                        {
                                            <!-- THE BOSS ANNOUNCES ITS NEXT MOVE SO THE PLAYER CAN PLAN AROUND IT -->
                                            <div style="background: rgba(239,68,68,0.1); border: 1px solid #7f1d1d; border-radius: 8px; padding: 10px 15px; margin-bottom: 15px; color: #fca5a5;">
                                                @BossMoveIcon(bossNextMove) Next boss move: <strong>@bossNextMoveName</strong> for <strong>@enemyIntentAttack DMG</strong>
                                                @if (bossNextMove == "LifeDrain")
                                                {
                                                    <span> (heals the boss)</span>
                                                }
                                            </div>
                                        }

                                        <!-- COMBAT EVENTS LOGGER FEED (column-reverse keeps the scroll pinned to the newest line, so the lines are rendered in reverse) -->
                                        <div role="log" aria-label="Battle log" tabindex="0"
                                            style="height: 180px; background: #0f172a; border-radius: 8px; padding: 15px; overflow-y: auto; display: flex; flex-direction: column-reverse; border: 1px solid #334155; font-family: monospace; color: #94a3b8; margin-bottom: 25px; line-height: 1.6;">
                                            @foreach (var log in Enumerable.Reverse(logs))
                                            {
                                                <div>@log</div>
                                            }
                                        </div>

                                        @if (battleResult is null)
                                        {
                                        <!-- DECK ACTION HAND CARD PANELS -->
                                        <div style="display: flex; justify-content: center; gap: 15px;">
                                            @foreach (var card in ArenaCards.Hand)
                                            {
                                                var recharging = rechargingCard == card.Id;
                                                var held = heldCards.FirstOrDefault(c => c.card == card.Id);
                                                var signature = HeroClassIcons.SignatureCard(State.HeroClass) == card.Id;
                                                <button @onclick="() => PlayTurn(card.Id)" disabled="@recharging"
                                                        title="@(signature ? $"{State.HeroClass} signature card. {card.Hint}" : card.Hint)"
                                                        style="background: @(recharging ? "#475569" : CosmeticStyles.CardBackground(State.CardSkin, card.Color)); width: 150px; height: 110px; border-radius: 12px; position: relative; border: @(signature ? "2px solid #c7d2fe" : "none"); color: white; text-shadow: 0 1px 2px rgba(0,0,0,0.7); font-weight: bold; cursor: @(recharging ? "not-allowed" : "pointer"); opacity: @(recharging ? "0.6" : "1");">
                                                    @if (signature)
                                                    {
                                                        <span style="position: absolute; top: -10px; right: -10px; width: 26px; height: 26px; line-height: 26px; border-radius: 50%; background: #1e1b4b; border: 2px solid #c7d2fe; font-size: 0.8rem;">@HeroClassIcons.For(State.HeroClass)</span>
                                                    }
                                                    @card.Icon @card.Label@(held is { level: > 1 } ? $" ★{held.level}" : "")<br /><small>@(held is null ? card.Effect : ArenaCards.EffectOf(held.damage, held.heal))</small><br />
                                                    <small style="font-weight: normal;">@(recharging ? "⏳ Recharging" : held is null ? card.Risk : ArenaCards.RiskOf(card.Id, held.failChance))</small>
                                                </button>
                                            }
                                                    </div>
                                        }
                                        else
                                        {
                                            <!-- BATTLE RESULT PANEL: SHOWS THE SERVER'S VERDICT AND THE REWARDS EARNED -->
                                            <div style="text-align: center; padding: 25px; border-radius: 12px; background: @(battleResult.won ? "rgba(34,197,94,0.1)" : "rgba(239,68,68,0.1)"); border: 2px solid @(battleResult.won ? "#22c55e" : "#ef4444");">
                                                <div style="font-size: 3rem; line-height: 1;">@(battleResult.won ? "🏆" : "💀")</div>
                                                <h2 style="margin: 10px 0 5px; color: @(battleResult.won ? "#4ade80" : "#f87171"); letter-spacing: 2px;">@(battleResult.won ? "VICTORY" : "DEFEAT")</h2>
                                                <p style="color: #cbd5e1; margin: 0 0 20px;">
                                                    @(battleResult.won ? $"{bossName} has fallen!" : $"{bossName} prevails... this time.")
                                                </p>

                                                <div style="display: flex; justify-content: center; gap: 30px; margin-bottom: 20px; font-weight: bold;">
                                                    <span style="color: #fbbf24;">🪙 +@battleResult.goldEarned Gold</span>
                                                    <span style="color: #a78bfa;">✨ +@battleResult.experienceEarned XP</span>
                                                </div>

                                                <RewardBonuses StreakBonus="battleResult.streakBonus" Bounties="battleResult.bounties" />

                                                @if (heroic && battleResult.won)
                                                {
                                                    <div style="color: #94a3b8; margin-bottom: 15px;">@(battleResult.reducedBossReward
                                                        ? "You've already claimed today's Heroic reward, so this win paid 25 gold. It comes back tomorrow."
                                                        : "👑 Heroic victory! That was today's Heroic reward; it comes back tomorrow.")</div>
                                                }
                                                else if (battleResult.reducedBossReward)
                                                {
                                                    <div style="color: #94a3b8; margin-bottom: 15px;">You've used today's 5 full-reward boss wins, so this one paid 25 gold. Full rewards come back tomorrow.</div>
                                                }
                                                else if (battleResult.won && battleResult.fullRewardWinsLeft is { } left)
                                                {
                                                    <div style="color: #94a3b8; margin-bottom: 15px;">@(left == 0 ? "That was your last full-reward boss win today." : $"{left} full-reward boss win{(left == 1 ? "" : "s")} left today.")</div>
                                                }

                                                @if (battleResult.leveledUp)
                                                {
                                                    <div style="color: #fbbf24; font-weight: bold; margin-bottom: 20px;">⬆️ LEVEL UP! You are now level @battleResult.newLevel.</div>
                                                }

                                                <div style="display: flex; justify-content: center; gap: 15px;">
                                                    <button @onclick="ReturnToTown"
                                                            style="background: #334155; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">🏰 Return to Town</button>
                                                    <button @onclick="() => EnterArena(heroic)"
                                                            style="background: #dc2626; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">⚔️ Fight Again</button>
                                                </div>
                                            </div>
                                        }
                                                </div>
                                                break;
                                            }
                                        </div>

@code {
    private string inputUsername = string.Empty;
    private string inputPassword = string.Empty;
    private string chosenClass = "Sorcerer";
    private bool creatingHero; // The sign-in screen is creating a new hero rather than signing in

    private void ToggleCreatingHero()
    {
        creatingHero = !creatingHero;
        statusMsg = string.Empty;
    }
    private string statusMsg = string.Empty;
    private bool uploading = false;
    private IBrowserFile? selectedFile;
    private bool showPortraitPopup;
    private ElementReference portraitCloseButton;
    private bool focusPortraitPopup;
    private string uploadError = string.Empty;

    private void OpenPortraitPopup()
    {
        selectedFile = null;
        uploadError = string.Empty;
        showPortraitPopup = true;
        focusPortraitPopup = true; // keyboard and screen-reader users land inside the popup
    }

    private void PortraitPopupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePortraitPopup();
    }

    private void ClosePortraitPopup()
    {
        if (!uploading) showPortraitPopup = false;
    }

    // Arena State (mirrors the server's battle; the server decides every outcome)
    private Guid battleId;
    private int playerHp = 100;
    private int playerMaxHp = 100; // More than 100 when a Battle Elixir was drunk
    private List<BattleCardDto> heldCards = new(); // The cards as upgraded in the Gold Shop
    private int enemyHp = 160;
    private int enemyMaxHp = 160;
    private bool heroic; // Fighting the Heroic boss, for players with every card maxed out
    private string bossName = "The Shadow Overlord";
    private int enrageBelowPercent = 40;
    private bool bossEnraged; // Below 40% health the boss's attacks hit 50% harder
    private int enemyIntentAttack = 15; // Damage of the boss's announced move
    private string bossNextMove = "Slash";
    private string bossNextMoveName = "Slash";
    private string? rechargingCard; // Dragon Claw and Holy Shield can't be played two turns in a row
    private int turnCount = 1;
    private bool isPlayerTurn = true; // Prevents button click spamming
    private bool matchConcluding = false; // Locks inputs during network saves
    private BattleResultView? battleResult; // Set when the server ends the battle
    private List<string> logs = new() { "⚔️ Match Initialized. Select an action card block." };

    // Leaderboard state references
    private bool leaderboardLoading = false;
    private List<PlayerProfileDto>? leaderboardPlayers;
    private int? registeredPlayers;

    protected override void OnInitialized()
    {
        State.OnStateChanged += StateHasChanged;
        Sounds.OnChanged += StateHasChanged;
    }

    // The saved sound setting lives in the browser, which is only reachable after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Sounds.LoadAsync();
        if (focusPortraitPopup)
        {
            focusPortraitPopup = false;
            await portraitCloseButton.FocusAsync();
        }
    }

    // Play Game / Create Hero stay disabled until both fields have something in them.
    private bool CredentialsEntered => !string.IsNullOrWhiteSpace(inputUsername) && !string.IsNullOrEmpty(inputPassword);

    private Task SubmitCredentials() => creatingHero ? HandleRegister() : HandleLogin();

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(inputUsername) || string.IsNullOrEmpty(inputPassword)) return;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v1/auth/login", new { Username = inputUsername, Password = inputPassword });
            if (res.IsSuccessStatusCode)
            {
                await StartSession(res);
            }
            else statusMsg = res.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Wrong character name or password.",
                HttpStatusCode.Locked => "Too many failed attempts. Try again in a few minutes.",
                _ => "Sign-in failed. Please try again."
            };
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(inputUsername) || string.IsNullOrEmpty(inputPassword)) return;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/v1/auth/register", new { Username = inputUsername, Password = inputPassword, Class = chosenClass });
            if (res.IsSuccessStatusCode)
            {
                // Registration signs the new hero straight in.
                await StartSession(res);
            }
            else if (res.StatusCode == HttpStatusCode.Conflict) statusMsg = "Username already claimed inside database.";
            else statusMsg = await ReadValidationMessage(res);
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task StartSession(HttpResponseMessage res)
    {
        var auth = await res.Content.ReadFromJsonAsync<AuthResponseDto>();
        if (auth?.player is null) return;

        statusMsg = string.Empty;
        inputPassword = string.Empty;
        creatingHero = false;
        State.UpdateClass(auth.player.@class);
        State.SetPlayerSession(new SessionTokens(auth.accessToken, auth.expiresAt, auth.refreshToken), auth.player.id, auth.player.username, auth.player.gold, auth.player.level, auth.player.avatarUrl);
        State.UpdateCosmetics(auth.player.frame, auth.player.cardSkin);
    }

    // Turns an ASP.NET Core validation problem (e.g. password rules) into one readable line.
    private static async Task<string> ReadValidationMessage(HttpResponseMessage res)
    {
        try
        {
            var problem = await res.Content.ReadFromJsonAsync<ValidationProblemDto>();
            var messages = problem?.errors?.SelectMany(e => e.Value).ToList();
            if (messages is { Count: > 0 }) return string.Join(" ", messages);
        }
        catch (System.Text.Json.JsonException) { }
        return "Registration failed. Please check your details.";
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadError = string.Empty;
    }

    private async Task ExecuteAvatarUpload()
    {
        if (selectedFile == null) return;
        try
        {
            uploading = true;
            uploadError = string.Empty;
            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(streamContent, "File", selectedFile.Name);

            var res = await Http.PostAsync("/api/v1/players/me/avatar", content);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<UploadResponse>();
                if (result != null) State.UpdateAvatar(result.avatarUrl);
                selectedFile = null;
                showPortraitPopup = false;
            }
            else uploadError = res.StatusCode switch
            {
                HttpStatusCode.BadRequest or HttpStatusCode.RequestEntityTooLarge => "That file couldn't be used. Pick a PNG or JPG under 5 MB.",
                HttpStatusCode.TooManyRequests => "You've changed your portrait a lot recently. Please try again later.",
                _ => "Upload failed. Please try again."
            };
        }
        catch { uploadError = "Upload failed. Make sure the file is a PNG or JPG under 5 MB and try again."; }
        finally { uploading = false; }
    }

    // --- ⚔️ SERVER-AUTHORITATIVE TURN-BASED COMBAT ---
    // The API owns the battle: we send the chosen card and replay what the server decided.
    private async Task EnterArena(bool heroic = false)
    {
        try
        {
            var res = await Http.PostAsync(heroic ? "/api/v1/battles/pve?difficulty=Heroic" : "/api/v1/battles/pve", null);
            if (!res.IsSuccessStatusCode)
            {
                statusMsg = res.StatusCode == HttpStatusCode.BadRequest
                    ? await ReadValidationMessage(res)
                    : "The arena gates are closed. Please try again.";
                return;
            }
            statusMsg = string.Empty;

            var battle = await res.Content.ReadFromJsonAsync<BattleStateDto>();
            if (battle is null) return;

            ResetMatch();
            ApplyBattleState(battle);
            if (res.StatusCode == HttpStatusCode.OK)
            {
                logs.Add($"↩️ Resuming your battle on turn {battle.turn}.");
            }
            State.ChangeScreen(GameScreen.BattleArena);
        }
        catch { statusMsg = "API Network Link Offline."; }
    }

    private async Task PlayTurn(string card)
    {
        if (!isPlayerTurn || matchConcluding || enemyHp <= 0 || playerHp <= 0) return;

        isPlayerTurn = false; // Freeze spam-clicking path blocks

        PlayCardResponseDto? result;
        try
        {
            var res = await Http.PostAsJsonAsync($"/api/v1/battles/pve/{battleId}/turns", new { Card = card });
            if (!res.IsSuccessStatusCode)
            {
                logs.Add($"[API Rejection] The move was not accepted: {await res.Content.ReadAsStringAsync()}");
                isPlayerTurn = true;
                return;
            }
            result = await res.Content.ReadFromJsonAsync<PlayCardResponseDto>();
        }
        catch (Exception ex)
        {
            logs.Add($"[Network Error] Could not reach the arena: {ex.Message}");
            isPlayerTurn = true;
            return;
        }
        if (result is null) { isPlayerTurn = true; return; }

        var turn = result.turnResult;

        // 1. SHOW THE PLAYER'S CARD
        if (turn.cardFailed)
        {
            logs.Add($"🌀 Turn {turn.turn}: Your {turn.cardName} was {turn.cardFailedReason} by {bossName}!");
            await Sounds.PlayAsync(Sound.Miss);
        }
        else if (turn.damageDealt > 0)
        {
            enemyHp = Math.Max(0, enemyHp - turn.damageDealt);
            logs.Add($"» Turn {turn.turn}: You cast {turn.cardName} dealing {turn.damageDealt} DMG.");
            await Sounds.PlayAsync(SoundEffects.ForCard(turn.cardName));
        }
        else if (card == "HolyShield")
        {
            playerHp += turn.healthRestored;
            logs.Add($"» Turn {turn.turn}: You raise {turn.cardName} and recover {turn.healthRestored} HP.");
            await Sounds.PlayAsync(Sound.Shield);
        }

        // 2. SHOW THE BOSS'S COUNTER-ATTACK WITH A SHORT DRAMATIC PAUSE
        if (turn.bossDamage is int bossDamage)
        {
            StateHasChanged();
            logs.Add($"⏳ {bossName} winds up a {turn.bossMoveName}...");
            await Task.Delay(1000);
            if (turn.attackBlocked)
            {
                logs.Add($"🛡️ Your shield blocks the {turn.bossMoveName}! No damage taken.");
                await Sounds.PlayAsync(Sound.Block);
            }
            else
            {
                logs.Add($"💥 {turn.bossMoveName} hits you for {bossDamage} damage!");
                await Sounds.PlayAsync(Sound.Hit);
            }
            if (turn.bossHealed > 0)
            {
                logs.Add($"🩸 {bossName} drains {turn.bossHealed} HP back.");
                await Sounds.PlayAsync(Sound.Drain);
            }
        }

        var wasEnraged = bossEnraged;
        ApplyBattleState(result.battle);
        if (bossEnraged && !wasEnraged && result.battle.status == "InProgress")
        {
            logs.Add($"😡 {bossName} is badly hurt and flies into a rage! Its attacks now hit 50% harder.");
            await Sounds.PlayAsync(Sound.Drain);
        }

        // 3. THE SERVER SAYS WHETHER THE FIGHT IS OVER
        if (result.battle.status != "InProgress")
        {
            HandleMatchResolution(result);
            return;
        }

        logs.Add($"⚠️ {bossName} prepares {bossNextMoveName} for {enemyIntentAttack} DMG.");

        // 4. UNLOCK CONTROLS
        isPlayerTurn = true;
        StateHasChanged();
    }

    private void ApplyBattleState(BattleStateDto battle)
    {
        battleId = battle.id;
        playerHp = battle.playerHp;
        playerMaxHp = battle.playerMaxHp;
        heldCards = battle.cards;
        enemyHp = battle.bossHp;
        enemyMaxHp = battle.bossMaxHp;
        heroic = battle.difficulty == "Heroic";
        bossName = battle.bossName;
        enrageBelowPercent = battle.enrageBelowPercent;
        bossEnraged = battle.bossEnraged;
        enemyIntentAttack = battle.bossNextAttack;
        bossNextMove = battle.bossNextMove;
        bossNextMoveName = battle.bossNextMoveName;
        rechargingCard = battle.rechargingCard;
        turnCount = battle.turn;
    }

    private void HandleMatchResolution(PlayCardResponseDto result)
    {
        matchConcluding = true; // Lock all inputs

        var won = result.battle.status == "Won";
        _ = Sounds.PlayAsync(won ? Sound.Victory : Sound.Defeat);
        logs.Add(won
            ? "🏆 VICTORY! The server confirmed your win."
            : $"💀 DEFEAT! {bossName} prevails.");

        var levelBefore = State.Level;
        if (result.reward is { } reward)
        {
            logs.Add($"🪙 +{reward.goldEarned} gold, +{reward.experienceEarned} XP.");
            if (reward.streakBonus > 0) logs.Add($"🔥 Win streak bonus: +{reward.streakBonus} gold.");
            foreach (var bounty in reward.bountiesCompleted) logs.Add($"📜 Bounty complete: {bounty.name} (+{bounty.reward} gold).");
            // Sync the header with the balances the server just saved
            State.UpdateRewards(reward.player.gold, reward.player.level);
        }

        // Stay in the arena and show the result until the player chooses what to do next
        battleResult = new BattleResultView(
            won,
            result.reward?.goldEarned ?? 0,
            result.reward?.experienceEarned ?? 0,
            State.Level > levelBefore,
            State.Level,
            result.reward?.streakBonus ?? 0,
            result.reward?.bountiesCompleted.Select(b => new RewardBonuses.BountyLine(b.name, b.reward)).ToList() ?? [],
            result.reward?.reducedBossReward ?? false,
            result.reward?.fullRewardBossWinsLeft);
        StateHasChanged();
    }

    private void ReturnToTown()
    {
        ResetMatch();
        State.ChangeScreen(GameScreen.CharacterDashboard);
    }

    private record BattleResultView(bool won, int goldEarned, int experienceEarned, bool leveledUp, int newLevel,
        int streakBonus, IReadOnlyList<RewardBonuses.BountyLine> bounties, bool reducedBossReward, int? fullRewardWinsLeft);

    // null is every hero ranked by rating; a class shows only duels fought as that class.
    private static readonly string?[] LeaderboardTabs = { null, "Sorcerer", "Paladin", "Ranger" };
    private string? leaderboardClass;

    private async Task LaunchLeaderboardView()
    {
        State.ChangeScreen(GameScreen.Leaderboard);
        await ShowLeaderboard(null);
    }

    private async Task ShowLeaderboard(string? heroClass)
    {
        leaderboardClass = heroClass;
        try
        {
            leaderboardLoading = true;
            var stats = Http.GetFromJsonAsync<PlayerStatsDto>("/api/v1/players/stats");
            var players = await Http.GetFromJsonAsync<List<PlayerProfileDto>>(
                heroClass is null ? "/api/v1/players/leaderboard" : $"/api/v1/players/leaderboard?class={heroClass}");
            var registered = (await stats)?.registeredPlayers;
            if (leaderboardClass != heroClass) return; // Another tab was picked while this one loaded
            leaderboardPlayers = players;
            registeredPlayers = registered;
        }
        catch
        {
            statusMsg = "Failed to load leaderboard profiles from API framework.";
        }
        finally
        {
            leaderboardLoading = false;
        }
    }

    private void ResetMatch() 
    { 
        battleId = Guid.Empty;
        playerHp = 100; 
        enemyHp = 160;
        bossEnraged = false;
        enemyIntentAttack = 15;
        bossNextMove = "Slash";
        bossNextMoveName = "Slash";
        rechargingCard = null;
        turnCount = 1;
        isPlayerTurn = true;
        matchConcluding = false;
        battleResult = null;
        logs = new() { "⚔️ Match Initialized. Select an action card block." }; 
    }

    private static string BossMoveIcon(string move) => move switch
    {
        "CrushingBlow" => "🔨",
        "LifeDrain" => "🩸",
        _ => "⚔️"
    };

    private async Task Logout()
    {
        statusMsg = string.Empty;
        await Tokens.SignOutAsync();
    }

    // --- FIXED DISPOSE SIGNATURE TO MATCH INTERFACE RULES ---
    void IDisposable.Dispose()
    {
        State.OnStateChanged -= StateHasChanged;
        Sounds.OnChanged -= StateHasChanged;
    }

    public class PlayerProfileDto 
    { 
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public Guid id { get; set; } 

        [System.Text.Json.Serialization.JsonPropertyName("username")]
        public string username { get; set; } = ""; 

        [System.Text.Json.Serialization.JsonPropertyName("gold")]
        public int gold { get; set; } 

        [System.Text.Json.Serialization.JsonPropertyName("level")]
        public int level { get; set; } 

        [System.Text.Json.Serialization.JsonPropertyName("class")]
        public string @class { get; set; } = "Sorcerer";

        // The leaderboard sends the class's display name.
        [System.Text.Json.Serialization.JsonPropertyName("heroClass")]
        public string? heroClass { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("avatarUrl")]
        public string? avatarUrl { get; set; } 

        public string? title { get; set; }
        public int rating { get; set; }
        public int pvpWins { get; set; }
        public int pvpLosses { get; set; }
        public string? frame { get; set; }
        public string? cardSkin { get; set; }
    }

    public class UploadResponse { public string avatarUrl { get; set; } = ""; }

    private record PlayerStatsDto(int registeredPlayers);

    public class BattleStateDto
    {
        public Guid id { get; set; }
        public int playerHp { get; set; }
        public int playerMaxHp { get; set; } = 100;
        public int bossHp { get; set; }
        public int bossMaxHp { get; set; } = 160;
        public bool bossEnraged { get; set; }
        public string bossNextMove { get; set; } = "Slash";
        public string bossNextMoveName { get; set; } = "Slash";
        public int bossNextAttack { get; set; }
        public string? rechargingCard { get; set; }
        public int turn { get; set; }
        public string status { get; set; } = "";
        public List<BattleCardDto> cards { get; set; } = new();
        public string difficulty { get; set; } = "Normal";
        public string bossName { get; set; } = "The Shadow Overlord";
        public int enrageBelowPercent { get; set; } = 40;
    }

    public class BattleCardDto
    {
        public string card { get; set; } = "";
        public int level { get; set; } = 1;
        public int damage { get; set; }
        public int heal { get; set; }
        public int failChance { get; set; }
    }

    public class BattleTurnDto
    {
        public int turn { get; set; }
        public string cardName { get; set; } = "";
        public bool cardFailed { get; set; }
        public string? cardFailedReason { get; set; }
        public int damageDealt { get; set; }
        public int healthRestored { get; set; }
        public string? bossMoveName { get; set; }
        public int? bossDamage { get; set; }
        public bool attackBlocked { get; set; }
        public int bossHealed { get; set; }
    }

    public class BattleRewardDto
    {
        public int goldEarned { get; set; }
        public int experienceEarned { get; set; }
        public PlayerProfileDto player { get; set; } = new();
        public int streakBonus { get; set; }
        public List<BountyRewardDto> bountiesCompleted { get; set; } = new();
        public bool reducedBossReward { get; set; }
        public int? fullRewardBossWinsLeft { get; set; }
    }

    public class BountyRewardDto
    {
        public string name { get; set; } = "";
        public int reward { get; set; }
    }

    public class PlayCardResponseDto
    {
        public BattleStateDto battle { get; set; } = new();
        public BattleTurnDto turnResult { get; set; } = new();
        public BattleRewardDto? reward { get; set; }
    }

    public class AuthResponseDto
    {
        public string accessToken { get; set; } = "";
        public DateTimeOffset expiresAt { get; set; }
        public string refreshToken { get; set; } = "";
        public PlayerProfileDto? player { get; set; }
    }

    public class ValidationProblemDto
    {
        public Dictionary<string, string[]>? errors { get; set; }
    }
}
