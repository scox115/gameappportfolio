@page "/admin"
@using System.Net
@inject HttpClient Http
@inject GameState State

<PageTitle>Admin tools · Kings of the Card Arena</PageTitle>

@* Admin tools: work through players' reports, find a player, rename them or take down their portrait,
   suspend or reinstate them, correct their gold, and read the audit log.
   The API enforces the Admin role; this page only hides itself from everyone else. *@
<div class="admin-shell">
<div class="admin-page">
    <header class="admin-header">
        <a href="" class="admin-home">⚔️ Back to town</a>
        <h1>🛡️ Admin tools</h1>
    </header>

    @if (!State.IsAdmin)
    {
        <p>These tools are for admins. Sign in with an admin account from the <a href="">town</a> first.</p>
    }
    else
    {
        <section aria-labelledby="reports-title">
            <h2 id="reports-title">Reports</h2>
            <p class="admin-muted">Names and portraits players reported, most reported first. Pick a hero to rename them, take the portrait down, or dismiss the reports.</p>
            @if (reports.Count == 0)
            {
                <p class="admin-muted">Nothing is waiting.</p>
            }
            else
            {
                <ul class="admin-reports">
                    @foreach (var r in reports)
                    {
                        <li class="@(selected?.id == r.targetId ? "admin-selected" : null)">
                            @if (r.avatarUrl is { } portrait)
                            {
                                <img src="@portrait" alt="@($"{r.targetName}'s reported portrait")" class="admin-portrait" />
                            }
                            <div>
                                <button class="admin-link" @onclick="() => SelectAsync(r.targetId)">@r.targetName</button>
                                <span class="admin-muted">· @(r.reason == "Portrait" ? "portrait" : "name") ·
                                    @r.reports report@(r.reports == 1 ? "" : "s") · last @AdminFormat.When(r.lastReportedAt)</span>
                                @foreach (var note in r.notes)
                                {
                                    <div class="admin-note">“@note”</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section aria-labelledby="find-title">
            <h2 id="find-title">Find a player</h2>
            <form class="admin-row" @onsubmit="SearchAsync">
                <label for="admin-search" class="visually-hidden">Part of a hero's name</label>
                <input id="admin-search" type="search" placeholder="Part of a hero's name" @bind="search" @bind:event="oninput" />
                <button type="submit" class="admin-button">Search</button>
            </form>

            @if (players is not null)
            {
                @if (players.Count == 0)
                {
                    <p class="admin-muted">No heroes match.</p>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr><th scope="col">Hero</th><th scope="col">Class</th><th scope="col">Level</th><th scope="col">Gold</th><th scope="col">Rating</th><th scope="col">Account</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in players)
                                {
                                    <tr class="@(selected?.id == p.id ? "admin-selected" : null)">
                                        <td><button class="admin-link" @onclick="() => SelectAsync(p.id)">@p.username</button></td>
                                        <td>@(p.@class)</td>
                                        <td>@p.level</td>
                                        <td>@p.gold.ToString("N0")</td>
                                        <td>@p.rating</td>
                                        <td>@AccountState(p.isAdmin, p.suspension)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>

        @if (selected is not null)
        {
            <section class="admin-card" aria-labelledby="player-title">
                <h2 id="player-title">@selected.username</h2>
                <p class="admin-muted">
                    Level @selected.level @(selected.@class) · @selected.gold.ToString("N0") gold · rating @selected.rating ·
                    @selected.pvpWins duel wins, @selected.pvpLosses losses
                    @if (selected.isAdmin) { <span> · admin</span> }
                    @if (selected.twoFactorEnabled) { <span> · two-factor sign-in on</span> }
                    @if (selected.lockedOutUntil is { } locked) { <span> · locked out after failed sign-ins until @AdminFormat.When(locked)</span> }
                </p>

                <div class="admin-row">
                    <img src="@Avatars.For(selected.avatarUrl, selected.username)" alt="@(selected.avatarUrl is null ? "" : $"{selected.username}'s portrait")" class="admin-portrait" />
                    @if (OpenReports.Count > 0)
                    {
                        <p class="admin-warning admin-flush">Waiting for an answer: @string.Join(" and ", OpenReports.Select(r => $"{r.reports} {(r.reason == "Portrait" ? "portrait" : "name")} report{(r.reports == 1 ? "" : "s")}")).</p>
                    }
                </div>

                @if (selected.suspension is { } s)
                {
                    <p class="admin-warning">Suspended @(s.until is { } until ? $"until {AdminFormat.When(until)}" : "until reinstated"). Reason: @s.reason</p>
                }

                <div class="admin-actions">
                    <form @onsubmit="SuspendOrReinstateAsync">
                        <h3>@(selected.suspension is null ? "Suspend" : "Reinstate")</h3>
                        @if (selected.suspension is null)
                        {
                            <label for="suspend-days">How long</label>
                            <select id="suspend-days" @bind="suspendDays">
                                <option value="1">1 day</option>
                                <option value="7">7 days</option>
                                <option value="30">30 days</option>
                                <option value="0">Until reinstated</option>
                            </select>
                        }
                        <label for="suspend-reason">Reason (the player sees it)</label>
                        <textarea id="suspend-reason" rows="2" maxlength="500" @bind="suspendReason" @bind:event="oninput"></textarea>
                        <button type="submit" class="admin-button @(selected.suspension is null ? "admin-danger" : null)"
                                disabled="@(busy || string.IsNullOrWhiteSpace(suspendReason) || selected.isAdmin)">
                            @(selected.suspension is null ? "Suspend" : "Reinstate")
                        </button>
                    </form>

                    <form @onsubmit="RenameAsync">
                        <h3>Rename</h3>
                        <label for="rename-name">New name (they can still sign in with the old one)</label>
                        <input id="rename-name" type="text" maxlength="50" @bind="newName" @bind:event="oninput" />
                        <label for="rename-reason">Reason for the rename</label>
                        <textarea id="rename-reason" rows="2" maxlength="500" @bind="renameReason" @bind:event="oninput"></textarea>
                        <button type="submit" class="admin-button" disabled="@(busy || string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(renameReason))">Rename</button>
                    </form>

                    <form @onsubmit="RemovePortraitAsync">
                        <h3>Remove portrait</h3>
                        <label for="portrait-reason">Reason for removing it</label>
                        <textarea id="portrait-reason" rows="2" maxlength="500" @bind="portraitReason" @bind:event="oninput"></textarea>
                        <button type="submit" class="admin-button admin-danger" disabled="@(busy || selected.avatarUrl is null || string.IsNullOrWhiteSpace(portraitReason))">
                            @(selected.avatarUrl is null ? "No portrait" : "Remove portrait")
                        </button>
                    </form>

                    @if (selected.twoFactorEnabled)
                    {
                        <form @onsubmit="TurnOffTwoFactorAsync">
                            <h3>Turn off two-factor</h3>
                            <p class="admin-muted admin-lead-in">For a player who lost their phone and recovery codes. Check it's really them first, such as through their recovery email.</p>
                            <label for="two-factor-reason">How you checked it's them</label>
                            <textarea id="two-factor-reason" rows="2" maxlength="500" @bind="twoFactorReason" @bind:event="oninput"></textarea>
                            <button type="submit" class="admin-button admin-danger" disabled="@(busy || string.IsNullOrWhiteSpace(twoFactorReason))">Turn off two-factor</button>
                        </form>
                    }

                    @if (OpenReports.Count > 0)
                    {
                        <form @onsubmit="DismissAsync">
                            <h3>Dismiss reports</h3>
                            <label for="dismiss-kind">Which reports</label>
                            <select id="dismiss-kind" @bind="dismissKind">
                                @foreach (var r in OpenReports)
                                {
                                    <option value="@r.reason">@(r.reason == "Portrait" ? "Portrait" : "Name") (@r.reports)</option>
                                }
                            </select>
                            <label for="dismiss-reason">Why it's fine</label>
                            <textarea id="dismiss-reason" rows="2" maxlength="500" @bind="dismissReason" @bind:event="oninput"></textarea>
                            <button type="submit" class="admin-button admin-quiet" disabled="@(busy || string.IsNullOrWhiteSpace(dismissReason))">Dismiss</button>
                        </form>
                    }

                    <form @onsubmit="CorrectGoldAsync">
                        <h3>Correct gold</h3>
                        <label for="gold-change">Gold to add (use a minus sign to take away)</label>
                        <input id="gold-change" type="number" step="1" @bind="goldChange" />
                        <label for="gold-reason">Reason</label>
                        <textarea id="gold-reason" rows="2" maxlength="500" @bind="goldReason" @bind:event="oninput"></textarea>
                        <button type="submit" class="admin-button" disabled="@(busy || goldChange == 0 || string.IsNullOrWhiteSpace(goldReason))">Apply</button>
                    </form>
                </div>

                @if (selected.history.Count > 0)
                {
                    <h3>History</h3>
                    <AuditList Entries="selected.history" />
                }
            </section>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="@(failed ? "admin-error" : "admin-ok")" role="@(failed ? "alert" : "status")">@message</p>
        }

        <section aria-labelledby="audit-title">
            <h2 id="audit-title">Audit log</h2>
            <p class="admin-muted">Everything admins have done, newest first. Entries are kept for a year.</p>
            @if (audit.Count == 0)
            {
                <p class="admin-muted">Nothing yet.</p>
            }
            else
            {
                <AuditList Entries="audit" />
                @if (moreAudit)
                {
                    <button class="admin-button admin-quiet" @onclick="LoadOlderAuditAsync">Show older</button>
                }
            }
        </section>
    }
</div>
</div>

@code {
    private const int AuditPage = 25;

    private string search = string.Empty;
    private List<AdminPlayerDto>? players;
    private AdminPlayerDetailDto? selected;
    private List<AuditEntryDto> audit = [];
    private List<ReportQueueDto> reports = [];
    private bool moreAudit;

    private int suspendDays = 7;
    private string suspendReason = string.Empty;
    private int goldChange;
    private string goldReason = string.Empty;
    private string newName = string.Empty;
    private string renameReason = string.Empty;
    private string portraitReason = string.Empty;
    private string twoFactorReason = string.Empty;
    private string dismissKind = "Name";
    private string dismissReason = string.Empty;

    private List<OpenReportDto> OpenReports => selected?.openReports ?? [];

    private bool busy;
    private bool failed;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!State.IsAdmin) return;
        await LoadAuditAsync();
        await LoadReportsAsync();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        players = await Http.GetFromJsonAsync<List<AdminPlayerDto>>($"/api/v1/admin/players?search={Uri.EscapeDataString(search.Trim())}");
    }

    private async Task SelectAsync(Guid id)
    {
        message = string.Empty;
        ClearForms();
        selected = await Http.GetFromJsonAsync<AdminPlayerDetailDto>($"/api/v1/admin/players/{id}");
        dismissKind = OpenReports.FirstOrDefault()?.reason ?? "Name";
    }

    private void ClearForms()
    {
        suspendReason = goldReason = renameReason = portraitReason = dismissReason = twoFactorReason = newName = string.Empty;
        goldChange = 0;
    }

    private Task SuspendOrReinstateAsync() => selected!.suspension is null
        ? ChangeAsync("suspend", new { Reason = suspendReason, Days = suspendDays == 0 ? (int?)null : suspendDays }, $"{selected.username} is suspended and was signed out.")
        : ChangeAsync("reinstate", new { Reason = suspendReason }, $"{selected.username} can sign in again.");

    private Task CorrectGoldAsync() =>
        ChangeAsync("gold", new { Change = goldChange, Reason = goldReason }, $"{selected!.username}'s gold was corrected by {goldChange:+#,0;-#,0}.");

    private Task RenameAsync() =>
        ChangeAsync("rename", new { NewName = newName.Trim(), Reason = renameReason }, $"{selected!.username} is now called {newName.Trim()}.");

    private Task TurnOffTwoFactorAsync() =>
        ChangeAsync("turn-off-two-factor", new { Reason = twoFactorReason }, $"{selected!.username} can sign in with their password alone now.");

    private Task RemovePortraitAsync() =>
        ChangeAsync("remove-portrait", new { Reason = portraitReason }, $"{selected!.username}'s portrait was taken down.");

    private Task DismissAsync() =>
        ChangeAsync("dismiss-reports", new { Kind = dismissKind, Reason = dismissReason }, $"The {dismissKind.ToLowerInvariant()} reports about {selected!.username} were dismissed.");

    private async Task ChangeAsync(string action, object body, string done)
    {
        if (selected is null || busy) return;
        busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/v1/admin/players/{selected.id}/{action}", body);
            if (response.IsSuccessStatusCode)
            {
                selected = await response.Content.ReadFromJsonAsync<AdminPlayerDetailDto>();
                (failed, message) = (false, done);
                ClearForms();
                dismissKind = OpenReports.FirstOrDefault()?.reason ?? "Name";
                await LoadAuditAsync();
                await LoadReportsAsync();
                await SearchAsync();
            }
            else
            {
                var problem = response.StatusCode == HttpStatusCode.Forbidden ? null : await ReadDetailAsync(response);
                (failed, message) = (true, problem ?? "That didn't work. Your admin role may have been removed; sign in again.");
            }
        }
        catch (HttpRequestException)
        {
            (failed, message) = (true, "Can't reach the game server. Try again in a moment.");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadAuditAsync()
    {
        audit = await Http.GetFromJsonAsync<List<AuditEntryDto>>($"/api/v1/admin/audit?take={AuditPage}") ?? [];
        moreAudit = audit.Count == AuditPage;
    }

    private async Task LoadReportsAsync()
    {
        reports = await Http.GetFromJsonAsync<List<ReportQueueDto>>("/api/v1/admin/reports") ?? [];
    }

    private async Task LoadOlderAuditAsync()
    {
        var older = await Http.GetFromJsonAsync<List<AuditEntryDto>>($"/api/v1/admin/audit?take={AuditPage}&before={audit[^1].id}") ?? [];
        audit.AddRange(older);
        moreAudit = older.Count == AuditPage;
    }

    private static async Task<string?> ReadDetailAsync(HttpResponseMessage response)
    {
        try
        {
            return (await response.Content.ReadFromJsonAsync<ProblemDto>())?.detail;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private static string AccountState(bool isAdmin, SuspensionDto? suspension) =>
        isAdmin ? "Admin" : suspension is null ? "Active" : "Suspended";

    private record SuspensionDto(DateTimeOffset? until, string reason);
    private record AdminPlayerDto(Guid id, string username, string @class, int level, int gold, int rating, bool isAdmin, SuspensionDto? suspension);
    private record AdminPlayerDetailDto(
        Guid id, string username, string @class, int level, int experiencePoints, int gold, int rating, int pvpWins, int pvpLosses,
        bool isAdmin, SuspensionDto? suspension, DateTimeOffset? lockedOutUntil, List<AuditEntryDto> history,
        string? avatarUrl, List<OpenReportDto>? openReports, bool twoFactorEnabled);
    private record OpenReportDto(string reason, int reports);
    private record ReportQueueDto(Guid targetId, string targetName, string? avatarUrl, string reason, int reports,
        DateTime firstReportedAt, DateTime lastReportedAt, List<string> notes);
    private record ProblemDto(string? detail);
}
