@using Game.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Http.Connections
@inject GameState State
@inject ApiEndpoint Api
@inject TokenRefresher Tokens
@inject SoundEffects Sounds
@inject HttpClient Http
@implements IAsyncDisposable

@* The live PvP arena: the player picks a wager, waits in the lobby for a real opponent with the
   same wager, then plays turns over SignalR. The server decides every result and pushes it to both players. *@
@if (battle is null)
{
    @* The arena's live numbers stay in view while the player waits for an opponent. *@
    <LivePulse />
}
<div class="arena-panel">
    @if (battle is null)
    {
        <!-- LOBBY: CHOOSE A WAGER, THEN WAIT FOR A SECOND PLAYER -->
        <div class="lobby">
            <div class="lobby-icon">🆚</div>
            <h2 class="lobby-title">PvP Lobby</h2>
            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <p class="lobby-error">@errorMsg</p>
            }
            @if (challenge is { } sent)
            {
                <p class="lobby-text">⚔️ You challenged <b>@sent.FriendName</b>. Waiting for them to accept... <span class="challenge-clock">@challengeSecondsLeft s</span></p>
                <p class="lobby-hint">A friendly duel: no gold at stake. They see your challenge wherever they are in the game.</p>
                <button @onclick="WithdrawChallenge"
                        class="ghost-button">Take back the challenge</button>
            }
            else if (searching)
            {
                <p class="lobby-text">@(stake > 0 ? $"Searching for an opponent who also wagers {stake} gold..." : "Searching for an opponent...")</p>
                <p class="lobby-hint">Nobody around? Practice against the Arena Bot while you wait, or sign in as another hero in a second browser window to battle yourself.</p>
                <button @onclick="DuelBot"
                        class="bot-button">🤖 Practice against the Arena Bot</button>
                <button @onclick="CancelSearch"
                        class="ghost-button">Change wager</button>
            }
            else if (picking)
            {
                <p class="wager-prompt">Stake gold on your next duel? You'll only meet someone who chose the same wager.</p>
                <p class="wager-fee">The winner takes both stakes minus a 10% arena fee.</p>
                <div class="wager-options">
                    @foreach (var option in Stakes)
                    {
                        var affordable = option <= State.Gold && (option == 0 || !State.IsGuest);
                        <button @onclick="() => Search(option)" disabled="@(!affordable)"
                                aria-label="@(option == 0 ? "Friendly duel" : $"Wager {option} gold")"
                                class="wager-button @(affordable ? (option == 0 ? "" : "is-gold") : "is-locked")">
                            @(option == 0 ? "🤝 Friendly duel" : $"🎲 {option} 🪙")
                        </button>
                    }
                </div>
                @if (State.IsGuest)
                {
                    <p class="guest-hint">Save your hero in town to duel for gold.</p>
                }
            }
            else if (string.IsNullOrEmpty(errorMsg))
            {
                <p class="lobby-text">Connecting to the arena...</p>
            }
            <button @onclick="LeaveLobby"
                    class="town-button">🏰 Back to Town</button>
        </div>
    }
    else
    {
        <!-- BOTH PLAYERS' HEALTH -->
        <div class="duel-heroes">
            @PlayerPanel(battle.You, "#3b82f6", "You")
            @PlayerPanel(battle.Opponent, "#ef4444", "Opponent")
        </div>

        @if (battle.AgainstBot)
        {
            <div class="duel-note">
                🤖 Practice duel against the Arena Bot: no gold, XP or rating is at stake.
            </div>
        }
        else if (battle.Practice)
        {
            <div class="duel-note">
                🤝 Practice duel: you're on the same network as your opponent, so no gold, XP or rating is at stake.
            </div>
        }

        @if (battle.Wager > 0)
        {
            <div class="duel-wager">
                🎲 @battle.Wager gold each on the line. The winner takes @(battle.Wager * 2 - battle.Wager * 2 / 10).
            </div>
        }

        @if (battle.Status == "InProgress")
        {
            <!-- WHOSE TURN, WITH THE SERVER'S TURN TIMER -->
            <div class="turn-banner @(battle.YourTurn ? "is-your-turn" : "")">
                @(battle.YourTurn ? "⚡ Your turn!" : $"⏳ Waiting for {battle.Opponent.Username}...")
                <span class="turn-timer @(secondsLeft <= 10 ? "is-hurry" : "")">@secondsLeft s</span>
            </div>
        }

        <!-- COMBAT LOG (column-reverse keeps the scroll pinned to the newest line, so the lines are rendered in reverse) -->
        <div role="log" aria-label="Battle log" tabindex="0" class="battle-log">
            @foreach (var log in Enumerable.Reverse(logs))
            {
                <div>@log</div>
            }
        </div>

        @if (battle.Status == "InProgress")
        {
            <div class="card-hand">
                @foreach (var card in ArenaCards.Hand)
                {
                    var recharging = battle.RechargingCard == card.Id;
                    var disabled = recharging || !battle.YourTurn || sending;
                    var held = battle.YourCards?.FirstOrDefault(c => c.Card == card.Id);
                    var signature = HeroClassIcons.SignatureCard(State.HeroClass) == card.Id;
                    <button class="hand-card @(disabled ? "is-disabled" : "") @(signature ? "is-signature" : "")" @onclick="() => PlayCard(card.Id)" disabled="@disabled" title="@(signature ? $"{State.HeroClass} signature card. {card.Hint}" : card.Hint)"
                            style="--card-bg: @(CosmeticStyles.CardBackground(State.CardSkin, card.Color))">
                        @if (signature)
                        {
                            <span class="signature-badge">@HeroClassIcons.For(State.HeroClass)</span>
                        }
                        @card.Icon @card.Label@(held is { Level: > 1 } ? $" ★{held.Level}" : "")<br /><small>@(held is null ? card.Effect : ArenaCards.EffectOf(held.Damage, held.Heal))</small><br />
                        <small class="card-risk">@(recharging ? "⏳ Recharging" : held is null ? card.Risk : ArenaCards.RiskOf(card.Id, held.FailChance))</small>
                    </button>
                }
            </div>
            <div class="forfeit-row">
                <button @onclick="Forfeit" class="forfeit-button">🏳️ Forfeit</button>
            </div>
        }
        else
        {
            <!-- RESULT PANEL -->
            var won = battle.YouWon == true;
            <div class="result-panel @(won ? "is-won" : "")">
                <div class="result-icon">@(won ? "🏆" : "💀")</div>
                <h2 class="result-title @(won ? "is-won" : "")">@(won ? "VICTORY" : "DEFEAT")</h2>
                <p class="result-text">@ResultText(won)</p>
                @if (reward?.NoRewardReason is { } noReward)
                {
                    <p class="no-reward">🤝 @noReward</p>
                }
                else if (reward is not null)
                {
                    <div class="reward-line">
                        <span class="reward-gold">🪙 +@reward.GoldEarned Gold</span>
                        <span class="reward-xp">✨ +@reward.ExperienceEarned XP</span>
                        @if (reward.RatingChange is { } change)
                        {
                            <span class="reward-rating @(change >= 0 ? "" : "is-down")">🏅 Rating @reward.Player.Rating (@(change >= 0 ? "+" : "")@change)</span>
                        }
                    </div>
                    <RewardBonuses WagerResult="reward.WagerResult" StreakBonus="reward.StreakBonus"
                                   Bounties="@(reward.BountiesCompleted?.Select(b => new RewardBonuses.BountyLine(b.Name, b.Reward)).ToList() ?? [])" />
                }
                <div class="result-actions">
                    <button @onclick="LeaveLobby" class="result-button">🏰 Return to Town</button>
                    <button @onclick="FindAnother" class="result-button is-find">🆚 Find Another Opponent</button>
                    <a href="replay/@battle.Id" class="result-replay">▶ Watch the replay</a>
                    @if (battle.AgainstBot)
                    {
                        <button @onclick="SparAgain" class="result-button is-spar">🤖 Spar Again</button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private HubConnection? hub;
    private PvpBattleDto? battle;
    private PvpRewardDto? reward;
    private List<string> logs = new();
    private bool searching;
    private bool sending;
    private string? errorMsg;
    private bool picking;
    private int stake;
    private static readonly int[] Stakes = [0, 50, 100, 250, 500];
    private int secondsLeft;
    private System.Threading.Timer? countdown;
    private ChallengeSentDto? challenge; // sent to a friend, waiting for their answer
    private int challengeSecondsLeft;

    protected override async Task OnInitializedAsync()
    {
        hub = new HubConnectionBuilder()
            .WithUrl(new Uri(Api.BaseAddress, "hubs/arena"), options =>
            {
                options.AccessTokenProvider = Tokens.GetAccessTokenAsync;
                // Straight to WebSockets: with several API replicas, a separate negotiate request could reach a
                // different replica from the connection itself.
                options.SkipNegotiation = true;
                options.Transports = HttpTransportType.WebSockets;
            })
            .WithAutomaticReconnect()
            .Build();

        hub.On<PvpUpdateDto>("MatchFound", update => InvokeAsync(() => OnMatchFound(update)));
        hub.On<PvpUpdateDto>("BattleUpdated", update => InvokeAsync(() => OnBattleUpdated(update)));
        hub.On<string>("ChallengeDeclined", reason => InvokeAsync(() =>
        {
            challenge = null;
            picking = battle is null;
            errorMsg = reason;
            StateHasChanged();
        }));
        hub.On<string>("SearchCancelled", reason => InvokeAsync(() =>
        {
            searching = false;
            picking = true;
            errorMsg = reason;
            StateHasChanged();
        }));

        // After a dropped connection comes back, rejoin the lobby or pick up an unfinished battle.
        // A challenge is taken back when its connection drops, so the player chooses again.
        hub.Reconnected += _ => InvokeAsync(() =>
        {
            if (challenge is not null)
            {
                challenge = null;
                errorMsg = "The connection dropped, so your challenge was taken back. Send it again from town.";
            }
            return searching ? Search(stake) : ResumeOrPick();
        });
        State.OnStateChanged += OnStateChanged;

        countdown = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 1000, 1000);

        try
        {
            await hub.StartAsync();
            if (!await AnswerFriendsAsync()) await ResumeOrPick();
        }
        catch (Exception ex)
        {
            errorMsg = $"Could not reach the arena: {ex.Message}";
        }
    }

    // An unfinished battle carries on; otherwise the player chooses a wager.
    private async Task ResumeOrPick()
    {
        try
        {
            var response = await Http.GetAsync("/api/v1/battles/pvp/current");
            if (response.StatusCode == System.Net.HttpStatusCode.OK
                && await response.Content.ReadFromJsonAsync<PvpBattleDto>(JsonOptions) is { } current)
            {
                // Rejoining the lobby hands the battle back over the hub, with the live turn timer.
                await Search(current.Wager);
                return;
            }
        }
        catch (Exception)
        {
            // Fall back to the wager picker.
        }
        picking = battle is null;
        StateHasChanged();
    }

    private async Task Search(int wager)
    {
        if (hub is null) return;
        try
        {
            errorMsg = null;
            stake = wager;
            searching = wager == 0
                ? await hub.InvokeAsync<bool>("FindOpponent")
                : await hub.InvokeAsync<bool>("FindWageredOpponent", wager);
            picking = false;
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message.Contains("HubException: ") ? ex.Message[(ex.Message.IndexOf("HubException: ") + 14)..] : ex.Message;
            searching = false;
            picking = true;
        }
        StateHasChanged();
    }

    // Leaves the lobby for a practice duel the server plays against you; MatchFound brings the battle.
    private async Task DuelBot()
    {
        if (hub is null) return;
        try
        {
            errorMsg = null;
            await hub.InvokeAsync("DuelBot");
            searching = false;
            picking = false;
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message.Contains("HubException: ") ? ex.Message[(ex.Message.IndexOf("HubException: ") + 14)..] : ex.Message;
        }
        StateHasChanged();
    }

    // A challenge accepted, or a friend picked to challenge, from another screen (see docs/adr/0037-friends-and-challenges.md).
    // Returns false when there was neither.
    private async Task<bool> AnswerFriendsAsync()
    {
        if (hub?.State != HubConnectionState.Connected) return false;
        if (State.TakeChallengeToAccept() is { } accepted)
        {
            await AcceptChallenge(accepted);
            return true;
        }
        if (State.TakeFriendToChallenge() is { } friend)
        {
            await ChallengeFriend(friend);
            return true;
        }
        return false;
    }

    // Accepting an invite while already on this screen.
    private void OnStateChanged()
    {
        if (State.ChallengeToAccept is not null || State.FriendToChallenge is not null) _ = InvokeAsync(AnswerFriendsAsync);
    }

    private async Task AcceptChallenge(Guid challengeId)
    {
        if (hub is null) return;
        try
        {
            errorMsg = null;
            if (searching) await hub.InvokeAsync("CancelSearch");
            searching = false;
            picking = false;
            await hub.InvokeAsync("AcceptChallenge", challengeId); // MatchFound brings the duel
        }
        catch (Exception ex)
        {
            errorMsg = HubError(ex);
            picking = battle is null;
        }
        StateHasChanged();
    }

    private async Task ChallengeFriend(ChallengeTarget friend)
    {
        if (hub is null) return;
        try
        {
            errorMsg = null;
            searching = false;
            picking = false;
            challenge = await hub.InvokeAsync<ChallengeSentDto?>("ChallengeFriend", friend.Id);
            challengeSecondsLeft = challenge?.SecondsLeft ?? 0;
        }
        catch (Exception ex)
        {
            errorMsg = HubError(ex);
            picking = battle is null;
        }
        StateHasChanged();
    }

    private async Task WithdrawChallenge()
    {
        challenge = null;
        picking = true;
        if (hub is not null)
        {
            try { await hub.InvokeAsync("WithdrawChallenge"); } catch { /* it runs out anyway */ }
        }
    }

    private static string HubError(Exception ex) =>
        ex.Message.Contains("HubException: ") ? ex.Message[(ex.Message.IndexOf("HubException: ") + 14)..] : ex.Message;

    private async Task CancelSearch()
    {
        if (hub is not null)
        {
            try { await hub.InvokeAsync("CancelSearch"); } catch { /* back to the picker anyway */ }
        }
        searching = false;
        picking = true;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web);

    private void OnMatchFound(PvpUpdateDto update)
    {
        searching = false;
        challenge = null;
        reward = null;
        logs = new() { $"⚔️ Battle on! You face {update.Battle.Opponent.Username}." };
        _ = Sounds.PlayAsync(update.Battle.YourTurn ? Sound.YourTurn : Sound.MatchFound);
        Apply(update);
        if (update.Battle.Wager > 0) _ = RefreshGoldAsync();
    }

    // The server takes a wager's stake when the duel starts, so show the new balance.
    private async Task RefreshGoldAsync()
    {
        try
        {
            if (await Http.GetFromJsonAsync<PvpProfileDto>("/api/v1/players/me", JsonOptions) is { } me)
            {
                State.UpdateGold(me.Gold);
            }
        }
        catch (Exception)
        {
            // The header catches up after the duel's rewards.
        }
    }

    private void OnBattleUpdated(PvpUpdateDto update)
    {
        if (battle is not null && update.Battle.Id != battle.Id) return;

        if (update.LastTurn is { } turn)
        {
            var who = turn.YourCard ? "You" : turn.PlayerName;
            _ = Sounds.PlayAsync(turn switch
            {
                { CardFailed: true } => Sound.Miss,
                { AttackBlocked: true } => Sound.Block,
                { DamageDealt: > 0, YourCard: false } => Sound.Hit,
                _ => SoundEffects.ForCard(turn.CardName)
            });
            if (turn.CardFailed)
                logs.Add($"🌀 Turn {turn.Turn}: {who} played {turn.CardName}, but it was {turn.CardFailedReason}!");
            else if (turn.AttackBlocked)
                logs.Add($"🛡️ Turn {turn.Turn}: {who} played {turn.CardName}, but it was blocked by a shield!");
            else if (turn.DamageDealt > 0)
                logs.Add($"» Turn {turn.Turn}: {who} cast {turn.CardName} for {turn.DamageDealt} DMG.");
            else
                logs.Add($"» Turn {turn.Turn}: {who} raised {turn.CardName}, healing {turn.HealthRestored} HP.");
        }

        if (update.Battle.Status != "InProgress")
        {
            _ = Sounds.PlayAsync(update.Battle.YouWon == true ? Sound.Victory : Sound.Defeat);
            logs.Add(update.Battle.EndReason switch
            {
                "Timeout" => update.Battle.YouWon == true ? "⌛ Your opponent ran out of time." : "⌛ You ran out of time.",
                "Forfeit" => update.Battle.YouWon == true ? "🏳️ Your opponent forfeited." : "🏳️ You forfeited.",
                _ => update.Battle.YouWon == true ? "🏆 Knockout! You win." : "💀 You were knocked out."
            });
        }

        Apply(update);
    }

    private void Apply(PvpUpdateDto update)
    {
        battle = update.Battle;
        secondsLeft = update.Battle.TurnSecondsLeft;
        if (update.Reward is { } earned)
        {
            reward = earned;
            State.UpdateRewards(earned.Player.Gold, earned.Player.Level);
        }
        StateHasChanged();
    }

    private void Tick()
    {
        if (challenge is { } sent && --challengeSecondsLeft <= 0)
        {
            errorMsg = $"{sent.FriendName} didn't answer in time.";
            _ = WithdrawChallenge();
            StateHasChanged();
        }
        if (battle?.Status != "InProgress" || secondsLeft <= 0) return;
        secondsLeft--;
        StateHasChanged();
    }

    private async Task PlayCard(string card)
    {
        if (hub is null || battle is null || sending) return;
        sending = true;
        try
        {
            await hub.InvokeAsync("PlayCard", battle.Id, card);
        }
        catch (Exception ex)
        {
            logs.Add($"[Move rejected] {ex.Message}");
        }
        finally
        {
            sending = false;
        }
    }

    private async Task Forfeit()
    {
        if (hub is null || battle is null) return;
        try
        {
            await hub.InvokeAsync("Forfeit", battle.Id);
        }
        catch (Exception ex)
        {
            logs.Add($"[Forfeit failed] {ex.Message}");
        }
    }

    private async Task SparAgain()
    {
        battle = null;
        reward = null;
        logs.Clear();
        await DuelBot();
    }

    private async Task FindAnother()
    {
        battle = null;
        reward = null;
        logs.Clear();
        if (stake <= State.Gold && (stake == 0 || !State.IsGuest))
        {
            await Search(stake);
        }
        else
        {
            picking = true;
        }
    }

    private async Task LeaveLobby()
    {
        if (challenge is not null) await WithdrawChallenge();
        if (hub is not null && searching)
        {
            try { await hub.InvokeAsync("CancelSearch"); } catch { /* leaving anyway */ }
        }
        State.ChangeScreen(GameScreen.CharacterDashboard);
    }

    private string ResultText(bool won) => battle?.EndReason switch
    {
        "Timeout" => won ? $"{battle.Opponent.Username} ran out of time." : "You ran out of time.",
        "Forfeit" => won ? $"{battle.Opponent.Username} forfeited." : "You forfeited the battle.",
        _ => won ? $"You knocked out {battle?.Opponent.Username}!" : $"{battle?.Opponent.Username} knocked you out."
    };

    private RenderFragment PlayerPanel(PvpPlayerDto player, string color, string label) => __builder =>
    {
        <div class="duel-hero" style="--hero-color: @color">
            <div class="duel-hero-head">
                <img src="@Avatars.For(player.AvatarUrl, player.Username)" alt=""
                     class="duel-avatar" style="@CosmeticStyles.Frame(player.Frame)" />
                <div>
                    <div class="duel-hero-class">@label · @HeroClassIcons.For(player.Class) @player.Class</div>
                    <div class="duel-hero-name">@player.Username @(player.Shielded ? "🛡️" : "")</div>
                </div>
            </div>
            <div class="duel-hero-rating">
                @if (battle?.AgainstBot == true && player.Id != State.PlayerId)
                {
                    @* The bot has no rating to win or lose, and nothing to report. *@
                    <span>Practice partner</span>
                }
                else
                {
                    <span>🏅 Rating @player.Rating</span>
                }
                @if (player.Id != State.PlayerId && battle?.AgainstBot != true)
                {
                    <ReportHero HeroId="player.Id" HeroName="@player.Username" HasPortrait="@(!string.IsNullOrEmpty(player.AvatarUrl))" />
                }
            </div>
            @if (!string.IsNullOrEmpty(player.Title))
            {
                <div class="duel-hero-title">👑 @player.Title</div>
            }
            <div class="hp-track">
                <div class="hp-fill" style="--hp: @(player.Hp * 100 / Math.Max(1, player.MaxHp))%"></div>
            </div>
            <div class="hp-text">@player.Hp / @player.MaxHp HP</div>
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        State.OnStateChanged -= OnStateChanged;
        countdown?.Dispose();
        if (hub is not null)
        {
            await hub.DisposeAsync();
        }
    }

    // Shapes of the messages the server pushes (see Game.Api.Models.PvpModels).
    private record PvpPlayerDto(Guid Id, string Username, string? Title, int Rating, string? AvatarUrl, string? Frame, int Hp, int MaxHp, bool Shielded, string Class = "Sorcerer");
    private record PvpBattleDto(Guid Id, PvpPlayerDto You, PvpPlayerDto Opponent, bool YourTurn, int Turn,
        DateTime TurnDeadline, int TurnSecondsLeft, string? RechargingCard, string Status, bool? YouWon, int Wager, bool Practice, string? EndReason,
        List<PvpCardDto>? YourCards, bool AgainstBot = false);
    private record PvpCardDto(string Card, int Level, int Damage, int Heal, int FailChance);
    private record PvpTurnDto(int Turn, bool YourCard, string PlayerName, string CardName, bool CardFailed,
        string? CardFailedReason, int DamageDealt, int HealthRestored, bool AttackBlocked);
    private record PvpProfileDto(Guid Id, string Username, int Gold, int Level, int Rating);
    private record PvpRewardDto(int GoldEarned, int ExperienceEarned, PvpProfileDto Player, int? RatingChange,
        int StreakBonus, List<PvpBountyDto>? BountiesCompleted, int? WagerResult, string? NoRewardReason = null);
    private record PvpBountyDto(string Name, int Reward);
    private record ChallengeSentDto(Guid Id, string FriendName, int SecondsLeft);
    private record PvpUpdateDto(PvpBattleDto Battle, PvpTurnDto? LastTurn, PvpRewardDto? Reward);
}
