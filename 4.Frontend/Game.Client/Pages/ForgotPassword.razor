@page "/forgot-password"
@inject HttpClient Http

<PageTitle>Forgot your password? · Kings of the Card Arena</PageTitle>

<InfoPage Title="Forgot your password?">
    <FeatureGate Feature="@FeatureFlags.AccountRecovery">
        <ChildContent>
            @if (sent)
            {
                <p class="recovery-ok" role="status">
                    If @username has a confirmed recovery email, a link to choose a new password is on its way. It works for an hour.
                    Check your spam folder if it doesn't arrive in a few minutes.
                </p>
                <p><a href="">Back to sign in</a></p>
            }
            else
            {
                <p>
                    Enter your hero's name. If you added a recovery email under <b>Your account and data</b>, we'll send a link to
                    choose a new password.
                </p>
                <form class="recovery-form" @onsubmit="SendAsync">
                    <label for="forgot-name">Hero name</label>
                    <input id="forgot-name" autocomplete="username" @bind="username" @bind:event="oninput" />
                    <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(username))">Send me a link</button>
                </form>
                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="recovery-error" role="alert">@error</p>
                }
            }
        </ChildContent>
        <Off>
            <p>Password reset by email isn't available here. If you can't sign in, email <a href="@LegalInfo.ContactUrl">@LegalInfo.Contact</a>.</p>
        </Off>
    </FeatureGate>
</InfoPage>

@code {
    private string username = string.Empty;
    private bool busy;
    private bool sent;
    private string error = string.Empty;

    private async Task SendAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(username)) return;
        busy = true;
        error = string.Empty;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/auth/forgot-password", new { Username = username.Trim() });
            if (response.IsSuccessStatusCode) sent = true;
            else error = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                ? "Too many requests from your network. Please wait a while and try again."
                : "That didn't work. Please try again.";
        }
        catch (HttpRequestException)
        {
            error = "The game server couldn't be reached. It may be waking up; try again in a minute.";
        }
        finally
        {
            busy = false;
        }
    }
}
