@using Game.Client.Services
@using System.Net.Http.Json
@inject GameState State
@inject HttpClient Http
@inject SoundEffects Sounds

@* The Gold Shop: spend battle winnings on card upgrades, elixirs, titles and prestige cosmetics.
   The server sets every price and checks the player's gold; this page only shows the offers. *@
<div style="max-width: 1000px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 16px; border: 1px solid #334155;">
    @* The header stays pinned while the shelves scroll, so the way back to town is always in reach. *@
    <div style="position: sticky; top: 0; z-index: 10; background: #1e293b; margin: -30px -30px 10px; padding: 20px 30px 15px; border-radius: 16px 16px 0 0; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
        <h2 style="margin: 0; color: #fbbf24;">🪙 Gold Shop</h2>
        <div style="display: flex; align-items: center; gap: 20px;">
            <span style="color: #fbbf24; font-weight: bold; font-size: 1.2rem;">You have @State.Gold gold</span>
            <button @onclick="BackToTown"
                    style="background: #334155; color: white; padding: 10px 20px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">🏰 Back to Town</button>
        </div>
    </div>
    <p style="color: #94a3b8; margin: 0 0 20px;">
        Upgrades make your cards stronger in boss fights and PvP duels. Titles show off your duel wins (you have @pvpWins).
        Prestige frames and card skins are for the heroes with gold to burn: they change how you look, never how you fight.
    </p>

    @if (!string.IsNullOrEmpty(message))
    {
        <div role="status" style="padding: 10px 15px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;
             background: @(messageIsError ? "rgba(239,68,68,0.1)" : "rgba(34,197,94,0.1)");
             border: 1px solid @(messageIsError ? "#7f1d1d" : "#166534");
             color: @(messageIsError ? "#fca5a5" : "#86efac");">@message</div>
    }

    @if (offers is null)
    {
        <p style="color: #94a3b8;">@(loadFailed ? "The shop is closed right now. Please try again." : "Opening the shop...")</p>
    }
    else
    {
        @foreach (var shelf in Sections)
        {
            var sectionOffers = offers.Where(o => shelf.Includes(o.item)).ToList();
            if (sectionOffers.Count == 0) continue;
            <h3 style="color: #f1f5f9; margin: 20px 0 10px; font-size: 1.05rem;">@shelf.Heading</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 15px;">
                @foreach (var offer in sectionOffers)
                {
                    var look = Look(offer.item);
                    var isTitle = offer.item.StartsWith("Title");
                    var cosmetic = CosmeticStyles.CosmeticOf(offer.item);
                    var ownedTitle = (isTitle || cosmetic is not null) && offer.owned > 0;
                    var equipped = ownedTitle && (isTitle ? equippedTitle == TitleOf(offer.item) : cosmetic == equippedFrame || cosmetic == equippedCardSkin);
                    var soldOut = offer.price is null;
                    var buyable = !soldOut && offer.lockedReason is null && offer.price <= State.Gold;
                    <div style="background: #0f172a; border: 1px solid @(soldOut && !ownedTitle ? "#334155" : look.Color); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 8px;">
                        @if (cosmetic is null)
                        {
                            <div style="font-size: 2rem;">@look.Icon</div>
                        }
                        else if (offer.item.StartsWith("Frame"))
                        {
                            <img src="@(string.IsNullOrEmpty(State.AvatarUrl) ? "https://dicebear.com" + State.Username : State.AvatarUrl)" alt=""
                                 style="width: 48px; height: 48px; border-radius: 50%; background: #1e293b; object-fit: cover; @CosmeticStyles.Frame(cosmetic)" />
                        }
                        else
                        {
                            <div style="display: flex; gap: 6px;">
                                @foreach (var card in ArenaCards.Hand)
                                {
                                    <div style="width: 38px; height: 50px; border-radius: 6px; display: flex; align-items: center; justify-content: center; background: @CosmeticStyles.CardBackground(cosmetic, card.Color);">@card.Icon</div>
                                }
                            </div>
                        }
                        <div style="font-weight: bold; color: #f1f5f9;">@offer.name</div>
                        <div style="color: #94a3b8; font-size: 0.9rem; flex: 1;">@offer.description</div>
                        <div style="color: #cbd5e1; font-size: 0.9rem;">
                            @if (isTitle)
                            {
                                <span>@(ownedTitle ? (equipped ? "✅ Showing after your name" : "Owned") : offer.lockedReason ?? "Unlocked")</span>
                            }
                            else if (cosmetic is not null)
                            {
                                <span>@(ownedTitle ? (equipped ? "✅ Wearing it" : "Owned") : "Prestige item")</span>
                            }
                            else if (offer.item.EndsWith("Elixir"))
                            {
                                <span>Carrying @offer.owned of @offer.maxOwned</span>
                            }
                            else
                            {
                                <span>Level @offer.owned of @offer.maxOwned (@look.Stat(offer.owned))</span>
                            }
                        </div>
                        @if (ownedTitle)
                        {
                            <button @onclick="() => (isTitle ? ShowTitle(equipped ? null : TitleOf(offer.item)) : Wear(offer.item, equipped ? null : cosmetic))" disabled="@buying"
                                    style="background: @(equipped ? "#334155" : look.Color); color: white; padding: 10px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">
                                @(isTitle ? (equipped ? "Hide title" : "Show this title") : (equipped ? "Take it off" : "Wear it"))
                            </button>
                        }
                        else
                        {
                            <button @onclick="() => Buy(offer)" disabled="@(!buyable || buying)"
                                    aria-label="@($"Buy {offer.name}")"
                                    style="background: @(buyable ? look.Color : "#475569"); color: white; padding: 10px; border: none; border-radius: 8px; font-weight: bold; cursor: @(buyable ? "pointer" : "not-allowed");">
                                @(soldOut ? (offer.item.EndsWith("Elixir") ? "Pouch full" : "Max level") : offer.lockedReason is not null ? $"🔒 {offer.price} 🪙" : $"Buy for {offer.price} 🪙")
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }

    <button @onclick="BackToTown"
            style="margin-top: 25px; background: #334155; color: white; padding: 12px 24px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">🏰 Back to Town</button>
</div>

@code {
    private void BackToTown() => State.ChangeScreen(GameScreen.CharacterDashboard);

    private List<ShopOfferDto>? offers;
    private int pvpWins;
    private string? equippedTitle;
    private string? equippedFrame;
    private string? equippedCardSkin;

    private record ShopSection(string Heading, Func<string, bool> Includes);

    private static readonly ShopSection[] Sections =
    [
        new("⚔️ Card Upgrades (boss fights and duels)", item => item.EndsWith("Upgrade")),
        new("🧪 Elixirs", item => item.EndsWith("Elixir")),
        new("👑 Duel Titles", item => item.StartsWith("Title")),
        new("✨ Prestige (looks only)", item => CosmeticStyles.CosmeticOf(item) is not null)
    ];
    private bool loadFailed;
    private bool buying;
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var shop = await Http.GetFromJsonAsync<ShopDto>("/api/shop");
            if (shop is not null) Show(shop);
        }
        catch (Exception)
        {
            loadFailed = true;
        }
    }

    private async Task Buy(ShopOfferDto offer)
    {
        buying = true;
        message = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/shop/purchases", new { Item = offer.item });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<ShopDto>() is { } shop)
            {
                Show(shop);
                message = offer.item switch
                {
                    "BattleElixir" => "Bought a Battle Elixir. You'll drink it at the start of your next boss fight.",
                    "DuelElixir" => "Bought a Duel Elixir. You'll drink it at the start of your next PvP duel.",
                    _ when offer.item.StartsWith("Title") => $"You are now {State.Username}, {offer.name.Replace("Title: ", "")}!",
                    _ when CosmeticStyles.CosmeticOf(offer.item) is not null => $"You're now wearing the {offer.name}!",
                    _ => $"{offer.name.Replace(" Upgrade", "")} is now level {offer.owned + 1}!"
                };
                messageIsError = false;
                await Sounds.PlayAsync(Sound.Purchase);
            }
            else
            {
                var problem = await response.Content.ReadFromJsonAsync<ProblemDto>();
                message = problem?.detail ?? problem?.message ?? "The shopkeeper refused that sale.";
                messageIsError = true;
            }
        }
        catch (Exception)
        {
            message = "Couldn't reach the shop. Please try again.";
            messageIsError = true;
        }
        finally
        {
            buying = false;
        }
    }

    private async Task ShowTitle(string? title)
    {
        buying = true;
        message = null;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/shop/title", new { Title = title });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<ShopDto>() is { } shop)
            {
                Show(shop);
                message = title is null ? "Your title is hidden." : "Your title now shows to duel opponents and on the leaderboard.";
                messageIsError = false;
            }
            else
            {
                message = "Couldn't change your title. Please try again.";
                messageIsError = true;
            }
        }
        catch (Exception)
        {
            message = "Couldn't reach the shop. Please try again.";
            messageIsError = true;
        }
        finally
        {
            buying = false;
        }
    }

    private async Task Wear(string item, string? cosmetic)
    {
        buying = true;
        message = null;
        try
        {
            var kind = item.StartsWith("Frame") ? "AvatarFrame" : "CardSkin";
            var response = await Http.PutAsJsonAsync("/api/shop/cosmetic", new { Kind = kind, Cosmetic = cosmetic });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<ShopDto>() is { } shop)
            {
                Show(shop);
                message = cosmetic is null ? "Taken off." : "Looking good.";
                messageIsError = false;
            }
            else
            {
                message = "Couldn't change your look. Please try again.";
                messageIsError = true;
            }
        }
        catch (Exception)
        {
            message = "Couldn't reach the shop. Please try again.";
            messageIsError = true;
        }
        finally
        {
            buying = false;
        }
    }

    // "TitleGladiator" (the shop item) sells "Gladiator" (the title).
    private static string TitleOf(string item) => item["Title".Length..];

    private void Show(ShopDto shop)
    {
        offers = shop.offers;
        pvpWins = shop.pvpWins;
        equippedTitle = shop.equippedTitle;
        equippedFrame = shop.equippedFrame;
        equippedCardSkin = shop.equippedCardSkin;
        State.UpdateGold(shop.gold);
        State.UpdateCosmetics(shop.equippedFrame, shop.equippedCardSkin);
    }

    private record ItemLook(string Icon, string Color, Func<int, string> Stat);

    // Matches the battle cards: each level above 1 adds 5 damage or healing.
    private static ItemLook Look(string item) => item switch
    {
        "FireballUpgrade" => new("🔥", "#ea580c", level => $"{20 + (level - 1) * 5} DMG"),
        "HolyShieldUpgrade" => new("🛡️", "#2563eb", level => $"{15 + (level - 1) * 5} HEAL"),
        "DragonClawUpgrade" => new("🐉", "#7c3aed", level => $"{35 + (level - 1) * 5} DMG"),
        "BattleElixir" => new("🧪", "#059669", _ => ""),
        "DuelElixir" => new("⚗️", "#0891b2", _ => ""),
        _ when item.StartsWith("Frame") => new("🖼️", "#a855f7", _ => ""),
        _ when item.StartsWith("CardSkin") => new("🃏", "#db2777", _ => ""),
        _ => new("👑", "#ca8a04", _ => "")
    };

    private class ShopDto
    {
        public int gold { get; set; }
        public int pvpWins { get; set; }
        public string? equippedTitle { get; set; }
        public string? equippedFrame { get; set; }
        public string? equippedCardSkin { get; set; }
        public List<ShopOfferDto> offers { get; set; } = new();
    }

    private class ShopOfferDto
    {
        public string item { get; set; } = "";
        public string name { get; set; } = "";
        public string description { get; set; } = "";
        public int? price { get; set; }
        public int owned { get; set; }
        public int maxOwned { get; set; }
        public string? lockedReason { get; set; }
    }

    private class ProblemDto
    {
        public string? detail { get; set; }
        public string? message { get; set; }
    }
}
