@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Choose a new password · Kings of the Card Arena</PageTitle>

<InfoPage Title="Choose a new password">
    @if (done)
    {
        <p class="recovery-ok" role="status">Your password was changed, and you were signed out everywhere else. Sign in with your new password.</p>
        <p><a href="">Sign in</a></p>
    }
    else if (userId is null || string.IsNullOrEmpty(token))
    {
        <p class="recovery-error" role="alert">This link is incomplete. Open it straight from the email, or <a href="forgot-password">ask for a new one</a>.</p>
    }
    else
    {
        <form class="recovery-form" @onsubmit="ResetAsync">
            <label for="new-password">New password (at least 8 characters)</label>
            <input id="new-password" type="password" autocomplete="new-password" @bind="password" @bind:event="oninput" />
            <label for="repeat-password">The same password again</label>
            <input id="repeat-password" type="password" autocomplete="new-password" @bind="repeat" @bind:event="oninput" />
            <button type="submit" disabled="@(busy || password.Length == 0 || password != repeat)">Change my password</button>
        </form>
        @if (password.Length > 0 && repeat.Length > 0 && password != repeat)
        {
            <p class="recovery-error">The two passwords don't match.</p>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <p class="recovery-error" role="alert">@error</p>
        }
    }
</InfoPage>

@code {
    [SupplyParameterFromQuery(Name = "user")] public Guid? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private Guid? userId;
    private string? token;
    private string password = string.Empty;
    private string repeat = string.Empty;
    private bool busy;
    private bool done;
    private string error = string.Empty;

    protected override void OnInitialized()
    {
        // Keep the link out of the address bar and history once it has been read.
        (userId, token) = (UserId, Token);
        if (token is not null) Navigation.NavigateTo("reset-password", replace: true);
    }

    private async Task ResetAsync()
    {
        if (busy || password != repeat) return;
        busy = true;
        error = string.Empty;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/auth/reset-password", new { UserId = userId, Token = token, NewPassword = password });
            if (response.IsSuccessStatusCode)
            {
                done = true;
                return;
            }

            error = await ProblemText.ReadAsync(response) ?? "That didn't work. Please try again.";
        }
        catch (HttpRequestException)
        {
            error = "The game server couldn't be reached. It may be waking up; try again in a minute.";
        }
        finally
        {
            busy = false;
        }
    }
}
