@using Game.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Http.Connections
@inject GameState State
@inject ApiEndpoint Api
@inject TokenRefresher Tokens
@implements IAsyncDisposable

@* Keeps a connection open while signed in, so signing in on another browser (or being suspended by
   an admin) signs this one out straight away instead of on its next click. *@

@code {
    private HubConnection? hub;
    private Guid connectedPlayerId;

    protected override void OnInitialized() => State.OnStateChanged += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(SyncAsync);

    private async Task SyncAsync()
    {
        var signedIn = !string.IsNullOrEmpty(State.AccessToken);

        if (hub is not null && (!signedIn || connectedPlayerId != State.PlayerId))
        {
            await StopAsync();
        }

        if (signedIn && hub is null)
        {
            connectedPlayerId = State.PlayerId;
            hub = new HubConnectionBuilder()
                .WithUrl(new Uri(Api.BaseAddress, "hubs/session"), options =>
                {
                    options.AccessTokenProvider = Tokens.GetAccessTokenAsync;
                    // Straight to WebSockets: with several API replicas, a separate negotiate request could reach a
                    // different replica from the connection itself.
                    options.SkipNegotiation = true;
                    options.Transports = HttpTransportType.WebSockets;
                })
                .WithAutomaticReconnect()
                .Build();

            hub.On("SessionEnded", () => InvokeAsync(() => State.SignOut(GameState.SignedInElsewhereMessage)));
            hub.On("Suspended", () => InvokeAsync(() => State.SignOut(GameState.SuspendedMessage)));

            try
            {
                await hub.StartAsync();
            }
            catch (Exception)
            {
                // Not essential: the API still refuses the old session's tokens on the next request.
                await StopAsync();
            }
        }
    }

    private async Task StopAsync()
    {
        var connection = hub;
        hub = null;
        if (connection is not null)
        {
            await connection.DisposeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        State.OnStateChanged -= OnStateChanged;
        await StopAsync();
    }
}
